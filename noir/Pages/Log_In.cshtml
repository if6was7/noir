@page
@model noir.Pages.Log_InModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>noir — log_in</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: #fff; color: #000; font-family: 'Montserrat', sans-serif; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; }
        .logo { font-family: 'Cinzel', serif; font-size: 4rem; letter-spacing: 14px; text-transform: lowercase; color: #000; text-decoration: none; text-align: center; line-height: 1; margin-bottom: 8px; }
        .logo-sub { font-size: 0.48rem; letter-spacing: 6px; text-transform: uppercase; color: #000; opacity: 0.28; font-weight: 600; text-align: center; margin-bottom: 56px; }
        .panel { width: 100%; max-width: 380px; }
        .field { position: relative; margin-bottom: 36px; }
        .field label { position: absolute; left: 0; top: 32px; font-family: 'Montserrat', sans-serif; font-size: 0.72rem; font-weight: 500; letter-spacing: 0.05em; color: #bbb; pointer-events: none; transition: top 0.2s ease, font-size 0.2s ease, color 0.2s ease, letter-spacing 0.2s ease; white-space: nowrap; }
        .field input:focus ~ label, .field input:not(:placeholder-shown) ~ label { top: 0px; font-size: 0.44rem; letter-spacing: 3.5px; text-transform: uppercase; color: #888; font-weight: 600; }
        .field input { width: 100%; border: none; border-bottom: 1px solid #ddd; padding: 28px 0 10px 0; font-family: 'Montserrat', sans-serif; font-size: 0.95rem; font-weight: 400; color: #000; background: transparent; outline: none; transition: border-color 0.25s; -webkit-appearance: none; -webkit-font-smoothing: antialiased; caret-color: #000; }
        .field input::placeholder { color: transparent; }
        .field input:focus { border-bottom-color: #000; }
        .field input:-webkit-autofill, .field input:-webkit-autofill:hover, .field input:-webkit-autofill:focus { -webkit-box-shadow: 0 0 0px 1000px #fff inset !important; -webkit-text-fill-color: #000 !important; transition: background-color 9999s 0s; }
        .error-msg { font-size: 0.44rem; letter-spacing: 2.5px; text-transform: uppercase; color: #c0392b; margin-top: -20px; margin-bottom: 20px; display: none; }
        .error-msg.visible { display: block; }
        .btn-login { width: 100%; height: 52px; background: #000; color: #fff; border: none; font-family: 'Montserrat', sans-serif; font-size: 0.58rem; font-weight: 600; text-transform: uppercase; letter-spacing: 5px; cursor: pointer; transition: background 0.2s; -webkit-appearance: none; }
        .btn-login:hover { background: #1a1a1a; }
        .btn-login:disabled { opacity: 0.5; cursor: not-allowed; }
        .divider-or { display: flex; align-items: center; gap: 16px; margin: 24px 0; font-size: 0.44rem; letter-spacing: 4px; text-transform: uppercase; color: #000; opacity: 0.22; }
        .divider-or::before, .divider-or::after { content: ''; flex: 1; height: 1px; background: #e0e0e0; }
        .btn-outline { width: 100%; height: 48px; background: transparent; border: 1px solid #e0e0e0; color: #000; font-family: 'Montserrat', sans-serif; font-size: 0.5rem; font-weight: 500; text-transform: uppercase; letter-spacing: 3px; cursor: pointer; transition: border-color 0.25s, background 0.25s; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 8px; -webkit-appearance: none; }
        .btn-outline:hover { border-color: #000; background: #fafafa; }
        .social-icon { width: 14px; height: 14px; flex-shrink: 0; }
        .google-btn-wrapper { position: relative; width: 100%; height: 48px; margin-bottom: 8px; }
        .google-btn-visual { position: absolute; inset: 0; z-index: 2; pointer-events: none; display: flex; align-items: center; justify-content: center; gap: 10px; border: 1px solid #e0e0e0; background: #fff; font-family: 'Montserrat', sans-serif; font-size: 0.5rem; font-weight: 500; text-transform: uppercase; letter-spacing: 3px; color: #000; transition: border-color 0.25s, background 0.25s; }
        .google-btn-wrapper:hover .google-btn-visual { border-color: #000; background: #fafafa; }
        #googleBtnContainer { position: absolute; inset: 0; z-index: 3; }
        #googleBtnContainer > div, #googleBtnContainer iframe { width: 100% !important; height: 48px !important; }
        .signup-link { margin-top: 0; }
        .status { margin-top: 48px; display: flex; align-items: center; gap: 7px; font-size: 0.42rem; letter-spacing: 3px; text-transform: uppercase; color: #000; opacity: 0.18; }
        .status-dot { width: 5px; height: 5px; border-radius: 50%; background: #000; opacity: 0.5; }
    </style>
</head>
<body>
    <a href="/" class="logo">noir</a>
    <div class="logo-sub">private collection</div>

    <div class="panel">
        <div id="loginMode">
            <div class="field">
                <input type="text" id="username" placeholder=" " autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="off" readonly onfocus="this.removeAttribute('readonly')">
                <label for="username">Username</label>
            </div>
            <div class="field">
                <input type="password" id="password" placeholder=" " autocomplete="off" readonly onfocus="this.removeAttribute('readonly')">
                <label for="password">Password</label>
            </div>
            <div class="error-msg" id="errorMsg">Invalid credentials — access denied</div>
            <button class="btn-login" id="loginBtn" onclick="handleLogin()">Log In</button>
            <div class="divider-or">or</div>

            <div class="signup-link">
                <button class="btn-outline" onclick="showSignupMode()">Create an account →</button>
            </div>

            <div class="google-btn-wrapper">
                <div class="google-btn-visual">
                    <svg class="social-icon" viewBox="0 0 24 24">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.47 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Continue with Google
                </div>
                <div id="googleBtnContainer"></div>
            </div>

            <button class="btn-outline" onclick="window.location.href='/Apple'">
                <svg class="social-icon" viewBox="0 0 24 24" fill="#000">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                </svg>
                Continue with Apple
            </button>
        </div>

        <div id="signupMode" style="display: none;">
            <div class="field">
                <input type="text" id="signupUsername" placeholder=" " autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="off">
                <label for="signupUsername">Username</label>
            </div>
            <div class="field">
                <input type="email" id="signupEmail" placeholder=" " autocomplete="off" spellcheck="false">
                <label for="signupEmail">Email</label>
            </div>
            <div class="field">
                <input type="password" id="signupPassword" placeholder=" " autocomplete="off">
                <label for="signupPassword">Password</label>
            </div>
            <div class="error-msg" id="signupErrorMsg"></div>
            <button class="btn-login" id="signupBtn" onclick="handleSignup()">Create Account</button>
            <div class="divider-or">or</div>
            <button class="btn-outline" onclick="showLoginMode()">← Back to login</button>
        </div>
    </div>

    <div class="status">
        <div class="status-dot"></div>
        vault accessible · 2026
    </div>

    <script>
        if (sessionStorage.getItem('noir_user')) {
            window.location.href = '/';
        }

        function showSignupMode() {
            document.getElementById('loginMode').style.display = 'none';
            document.getElementById('signupMode').style.display = 'block';
        }
        function showLoginMode() {
            document.getElementById('loginMode').style.display = 'block';
            document.getElementById('signupMode').style.display = 'none';
            document.getElementById('signupErrorMsg').classList.remove('visible');
        }

        function handleLogin() {
            var u = document.getElementById('username').value.trim();
            var p = document.getElementById('password').value;
            var err = document.getElementById('errorMsg');
            var btn = document.getElementById('loginBtn');

            if (!u || !p) {
                err.textContent = 'Enter username and password';
                err.classList.add('visible');
                setTimeout(function() { err.classList.remove('visible'); }, 3000);
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Logging in...';

            fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: u, password: p })
            })
            .then(function(r) {
                return r.json().then(function(data) {
                    // Фикс: AuthController возвращает 200 с { error } при невалидных кредах
                    if (!r.ok || data.error) {
                        throw new Error(data.error || 'Invalid credentials');
                    }
                    return data;
                });
            })
            .then(function(user) {
                sessionStorage.setItem('noir_user', JSON.stringify(user));
                window.location.href = '/';
            })
            .catch(function(e) {
                err.textContent = e.message || 'Invalid credentials — access denied';
                err.classList.add('visible');
                document.getElementById('password').value = '';
                btn.disabled = false;
                btn.textContent = 'Log In';
                setTimeout(function() { err.classList.remove('visible'); }, 3000);
            });
        }

        function handleSignup() {
            var username = document.getElementById('signupUsername').value.trim();
            var email = document.getElementById('signupEmail').value.trim();
            var password = document.getElementById('signupPassword').value;
            var err = document.getElementById('signupErrorMsg');
            var btn = document.getElementById('signupBtn');

            if (!username || !email || !password) {
                err.textContent = 'All fields are required';
                err.classList.add('visible');
                setTimeout(function() { err.classList.remove('visible'); }, 3000);
                return;
            }
            if (username.length < 3) {
                err.textContent = 'Username must be at least 3 characters';
                err.classList.add('visible');
                setTimeout(function() { err.classList.remove('visible'); }, 3000);
                return;
            }
            if (password.length < 6) {
                err.textContent = 'Password must be at least 6 characters';
                err.classList.add('visible');
                setTimeout(function() { err.classList.remove('visible'); }, 3000);
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Creating...';

            fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: username, email: email, password: password })
            })
            .then(function(r) {
                return r.json().then(function(data) {
                    if (!r.ok || data.error) {
                        throw new Error(data.error || 'Registration failed');
                    }
                    return data;
                });
            })
            .then(function(data) {
                sessionStorage.setItem('noir_user', JSON.stringify(data));
                window.location.href = '/';
            })
            .catch(function(e) {
                err.textContent = e.message;
                err.classList.add('visible');
                btn.disabled = false;
                btn.textContent = 'Create Account';
                setTimeout(function() { err.classList.remove('visible'); }, 3000);
            });
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                if (document.getElementById('loginMode').style.display !== 'none') handleLogin();
                else handleSignup();
            }
        });

        window.addEventListener('load', function() {
            if (typeof google !== 'undefined') {
                google.accounts.id.initialize({
                    client_id: '1037431245707-8uv7spq3us84nffkins4jt0tiu7ksihe.apps.googleusercontent.com',
                    callback: handleGoogleLogin,
                    use_fedcm_for_prompt: true
                });
                google.accounts.id.renderButton(
                    document.getElementById('googleBtnContainer'),
                    { type: 'standard', theme: 'outline', size: 'large', width: 380 }
                );
            }
        });

        function handleGoogleLogin(response) {
            fetch('/api/Auth/google', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ credential: response.credential })
            })
            .then(r => r.json())
            .then(data => {
                if (data.id) {
                    sessionStorage.setItem('noir_user', JSON.stringify(data));
                    if (data.isNew === true) {
                        window.location.href = '/Nickname';
                    } else {
                        window.location.href = '/';
                    }
                } else {
                    alert(data.error || 'Login failed');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Server error');
            });
        }
    </script>
</body>
</html>