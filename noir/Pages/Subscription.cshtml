@page
@model noir.Pages.SubscriptionModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>noir — subscription</title>
    <link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Cinzel:wght@700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #ffffff; --text: #000; --gray: #efefef;
            --purple: #4b0082; --accent-gray: #888; --accent-purple: #a855f7;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { background-color: #000; }
        body { background-color: var(--bg); color: var(--text); font-family: 'Goudy Old Style', serif; -webkit-font-smoothing: antialiased; min-height: 100vh; }

        header { background: #000; height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 60px; position: sticky; top: 0; z-index: 1000; }
        .brand-wrapper { display: inline-flex; align-items: flex-end; gap: 5px; text-decoration: none; }
        .brand { font-family: 'Cinzel', serif; font-size: 2.8rem; letter-spacing: 5px; text-transform: lowercase; color: #fff; line-height: 1; }
        .plus-sticker { display: none; color: var(--accent-purple); font-family: 'Montserrat', sans-serif; font-size: 0.5rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; line-height: 1; margin-bottom: 10px; }
        nav { display: flex; gap: 60px; }
        nav a { text-decoration: none; color: #fff; font-size: 1.5rem; opacity: 0.45; transition: 0.3s; }
        nav a:hover { opacity: 1; }
        .header-right { justify-self: end; display: flex; align-items: center; gap: 18px; }
        .header-avatar-wrap { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .header-avatar { width: 28px; height: 28px; border-radius: 50%; background: #1a1a1a; border: 1px solid #2a2a2a; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; font-weight: 600; color: #fff; overflow: hidden; font-family: 'Cinzel', serif; transition: border-color 0.3s; }
        .header-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .header-avatar.plus-ring { border-color: var(--accent-purple); }
        .header-username { font-family: 'Montserrat'; font-size: 0.65rem; letter-spacing: 2px; color: #fff; opacity: 0.5; text-transform: uppercase; }
        .logout-btn { font-family: 'Montserrat'; font-size: 0.6rem; letter-spacing: 2px; text-transform: uppercase; color: #fff; opacity: 0.3; background: none; border: none; cursor: pointer; transition: 0.2s; padding: 0; }
        .logout-btn:hover { opacity: 1; }

        .container { max-width: 900px; margin: 80px auto; padding: 0 40px; }

        .sub-header { border-left: 2px solid #000; padding-left: 30px; margin-bottom: 60px; }
        .sub-header-label { font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 4px; opacity: 0.4; margin-bottom: 10px; }
        .sub-header h1 { font-family: 'Cinzel'; font-size: 2.8rem; letter-spacing: 4px; text-transform: lowercase; font-weight: normal; }

        .plan-card { display: flex; justify-content: space-between; align-items: center; border: 1px solid #efefef; padding: 25px 30px; margin-bottom: 50px; position: relative; overflow: hidden; }
        .plan-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accent-purple); }
        .plan-name { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; }
        .plan-name-brand { font-family: 'Cinzel'; font-size: 1.4rem; letter-spacing: 4px; }
        .plan-name-plus { font-family: 'Montserrat'; font-size: 0.55rem; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--accent-purple); }
        .plan-desc { font-family: 'Montserrat'; font-size: 0.62rem; letter-spacing: 1px; opacity: 0.4; text-transform: uppercase; }
        .plan-price { text-align: right; }
        .plan-price-value { font-family: 'Montserrat'; font-size: 1.5rem; font-weight: 600; line-height: 1; }
        .plan-price-period { font-family: 'Montserrat'; font-size: 0.5rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; margin-top: 5px; }

        .section-label { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; color: var(--accent-gray); margin-bottom: 20px; display: block; }

        .perks-summary { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid #f0f0f0; border-left: 1px solid #f0f0f0; margin-bottom: 50px; margin-top: -8px; }
        .perk-cell { padding: 12px 16px; border-bottom: 1px solid #f0f0f0; border-right: 1px solid #f0f0f0; display: flex; align-items: center; gap: 10px; }
        .perk-dot-sm { width: 4px; height: 4px; border-radius: 50%; background: #d0c0f0; flex-shrink: 0; }
        .perk-cell-text { font-family: 'Montserrat'; font-size: 0.6rem; font-weight: 600; letter-spacing: 0.3px; }

        .payment-methods { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
        .pay-option { cursor: pointer; }
        .pay-option input { display: none; }
        .pay-label { display: flex; align-items: center; justify-content: center; width: 110px; height: 76px; border: 1px solid var(--gray); transition: border-color 0.3s; cursor: pointer; }
        .pay-label:hover { border-color: #aaa; }
        .pay-option input:checked + .pay-label { border-color: #000; outline: 1px solid #000; }
        .pay-img { width: 68px; height: 42px; object-fit: contain; }
        .balance-label { font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 3px; font-weight: 500; opacity: 0.5; }

        .error-message { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); padding: 12px; text-align: center; font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 2px; color: #ef4444; margin-bottom: 20px; display: none; }

        .confirm-btn { width: 100%; height: 80px; background: #000; color: #fff; border: none; font-family: 'Montserrat'; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 6px; cursor: pointer; transition: 0.5s; margin-bottom: 20px; }
        .confirm-btn:hover { background: var(--purple); }
        .already-member-text { width: 100%; height: 80px; display: none; align-items: center; justify-content: center; font-family: 'Montserrat'; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 6px; opacity: 0.3; margin-bottom: 20px; }
        .confirm-note { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 2px; opacity: 0.3; text-align: center; }

        .success-screen { display: none; text-align: center; padding: 80px 0; }
        .success-screen.visible { display: block; }
        .success-icon { font-size: 3rem; margin-bottom: 30px; opacity: 0.15; font-family: 'Cinzel'; }
        .success-title { font-family: 'Cinzel'; font-size: 2.5rem; letter-spacing: 6px; margin-bottom: 20px; }
        .success-sub { font-family: 'Montserrat'; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.4; margin-bottom: 50px; }
        .back-btn { display: inline-block; padding: 16px 40px; border: 1px solid #000; font-family: 'Montserrat'; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 3px; text-decoration: none; color: #000; transition: 0.3s; }
        .back-btn:hover { background: #000; color: #fff; }

        .footer { margin-top: 120px; border-top: 1px solid #000; padding: 60px 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
        .footer-brand { font-family: 'Cinzel', serif; font-size: 1.2rem; letter-spacing: 5px; text-transform: lowercase; }
        .footer-copy { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: center; }
        .footer-tagline { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: right; }
    </style>
</head>
<body>
    <header>
        <a href="/" class="brand-wrapper">
            <span class="brand">noir</span>
            <span id="headerPlus" class="plus-sticker">plus</span>
        </a>
        <nav>
            <a href="/">Catalog</a>
            <a href="/Auction">Auction</a>
            <a href="/Archive">Archive</a>
            <a href="/Upload">Upload</a>
        </nav>
        <div class="header-right">
            <div class="header-avatar-wrap" onclick="window.location.href='/Account'">
                <div class="header-avatar" id="headerAvatar"></div>
                <span class="header-username" id="headerUsername"></span>
            </div>
            <button class="logout-btn" onclick="logout()">exit</button>
        </div>
    </header>

    <main class="container">
        <div id="subForm" style="display:none;">
            <div class="sub-header">
                <div class="sub-header-label">noir private collection — membership</div>
                <h1>noir plus</h1>
            </div>

            <div class="plan-card">
                <div>
                    <div class="plan-name">
                        <span class="plan-name-brand">noir</span>
                        <span class="plan-name-plus">plus</span>
                    </div>
                    <div class="plan-desc">Monthly membership · renews automatically</div>
                </div>
                <div class="plan-price">
                    <div class="plan-price-value">€10.99</div>
                    <div class="plan-price-period">per month</div>
                </div>
            </div>

            <span class="section-label">What's included</span>
            <div class="perks-summary">
                <div class="perk-cell"><div class="perk-dot-sm"></div><span class="perk-cell-text">Unlimited listings</span></div>
                <div class="perk-cell"><div class="perk-dot-sm"></div><span class="perk-cell-text">Commission 5%</span></div>
                <div class="perk-cell"><div class="perk-dot-sm"></div><span class="perk-cell-text">High-value access</span></div>
                <div class="perk-cell"><div class="perk-dot-sm"></div><span class="perk-cell-text">Profile banner</span></div>
                <div class="perk-cell"><div class="perk-dot-sm"></div><span class="perk-cell-text">Video &amp; GIF avatar</span></div>
                <div class="perk-cell"><div class="perk-dot-sm"></div><span class="perk-cell-text">Purple avatar ring</span></div>
                <div class="perk-cell"><div class="perk-dot-sm"></div><span class="perk-cell-text">Member signature</span></div>
                <div class="perk-cell"><div class="perk-dot-sm"></div><span class="perk-cell-text">Early auction access</span></div>
            </div>

            <span class="section-label">Payment method</span>
            <div class="payment-methods">
                <label class="pay-option"><input type="radio" name="payment" value="visa" checked><span class="pay-label"><img class="pay-img" src="/images/visa.jpg" alt="Visa"></span></label>
                <label class="pay-option"><input type="radio" name="payment" value="mastercard"><span class="pay-label"><img class="pay-img" src="/images/mastercard.jpg" alt="Mastercard"></span></label>
                <label class="pay-option"><input type="radio" name="payment" value="mir"><span class="pay-label"><img class="pay-img" src="/images/mir.jpg" alt="Mir"></span></label>
                <label class="pay-option"><input type="radio" name="payment" value="paypal"><span class="pay-label"><img class="pay-img" src="/images/paypal.jpg" alt="PayPal"></span></label>
                <label class="pay-option"><input type="radio" name="payment" value="applepay"><span class="pay-label"><img class="pay-img" src="/images/applepay.jpg" alt="Apple Pay"></span></label>
                <label class="pay-option"><input type="radio" name="payment" value="balance"><span class="pay-label"><span class="balance-label">Balance</span></span></label>
            </div>

            <div class="error-message" id="balanceError">Insufficient balance. Please top up your account.</div>

            <button class="confirm-btn" id="subscribeBtn" onclick="handleSubscribe()">Subscribe — €10.99 / month</button>
            <div class="already-member-text" id="alreadyMemberText">already a member</div>
            <div class="confirm-note" id="confirmNote">Cancel anytime. By subscribing you agree to our terms.</div>
        </div>

        <div class="success-screen" id="successScreen">
            <div class="success-icon">✦</div>
            <h2 class="success-title">welcome</h2>
            <div class="success-sub">your noir+ membership is now active</div>
            <a href="/Account" class="back-btn">Return to Account</a>
        </div>

        <footer class="footer">
            <span class="footer-brand">noir</span>
            <span class="footer-copy">© 2026 noir private collection. all rights reserved.</span>
            <span class="footer-tagline">objects of consequence</span>
        </footer>
    </main>

    <script>
        // ── FIX: helper to persist user to localStorage ──
        function persistUserToLocalStorage(u) {
            try {
                var reg = JSON.parse(localStorage.getItem('noir_registered_users') || '[]');
                var found = false;
                reg = reg.map(function(r) {
                    if (r.username === u.username) {
                        found = true;
                        return Object.assign({}, r, {
                            hasPlus: u.hasPlus,
                            balance: u.balance,
                            savedCards: u.savedCards
                        });
                    }
                    return r;
                });
                if (!found) {
                    reg.push({
                        username: u.username,
                        email: u.email || u.username,
                        password: u.googleAuth ? 'google_oauth' : (u.appleAuth ? 'apple_oauth' : ''),
                        role: u.role || 'user',
                        nickname: u.nickname || u.displayName || '',
                        displayName: u.displayName || u.nickname || '',
                        hasPlus: u.hasPlus || false,
                        balance: u.balance || 0,
                        savedCards: u.savedCards || []
                    });
                }
                localStorage.setItem('noir_registered_users', JSON.stringify(reg));
            } catch(e) {
                console.error('persistUserToLocalStorage error:', e);
            }
        }

        (function() {
            var userData = sessionStorage.getItem('noir_user');
            if (!userData) { window.location.href = '/Log_In'; return; }
            var user = JSON.parse(userData);
            var originalName = user.username || "";
            var clean = originalName.replace('@@', '');
            var avatarPath = '/images/avatar/' + clean + '.jpg';

            var ha = document.getElementById('headerAvatar');
            var haImg = document.createElement('img');
            haImg.src = avatarPath;
            haImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
            haImg.onerror = function() { ha.removeChild(haImg); ha.innerText = clean.charAt(0).toUpperCase() || 'U'; };
            ha.appendChild(haImg);

            document.getElementById('headerUsername').innerText = originalName;

            var isPlus = user.hasPlus === true || user.hasPlus === "true";

            document.getElementById('subForm').style.display = 'block';

            if (isPlus) {
                document.getElementById('headerPlus').style.display = 'inline';
                ha.classList.add('plus-ring');
                document.getElementById('subscribeBtn').style.display = 'none';
                document.getElementById('confirmNote').style.display = 'none';
                document.getElementById('alreadyMemberText').style.display = 'flex';
            }
        })();

        function handleSubscribe() {
            var selected = document.querySelector('input[name="payment"]:checked');
            if (!selected) return;

            var errorDiv = document.getElementById('balanceError');
            errorDiv.style.display = 'none';

            if (selected.value === 'balance') {
                var raw = sessionStorage.getItem('noir_user');
                if (!raw) { window.location.href = '/Log_In'; return; }
                var user = JSON.parse(raw);
                var balance = parseFloat(user.balance) || 0;

                if (balance >= 10.99) {
                    user.balance = (balance - 10.99).toFixed(2);
                    user.hasPlus = true;
                    sessionStorage.setItem('noir_user', JSON.stringify(user));

                    // ── FIX: persist balance deduction and hasPlus to localStorage ──
                    persistUserToLocalStorage(user);

                    document.getElementById('subForm').style.display = 'none';
                    document.getElementById('successScreen').classList.add('visible');
                } else {
                    errorDiv.style.display = 'block';
                    setTimeout(function() { errorDiv.style.display = 'none'; }, 3000);
                }
            } else {
                location.href = '/Payment?source=subscription&method=' + selected.value;
            }
        }

        function logout() {
            sessionStorage.removeItem('noir_user');
            window.location.href = '/Log_In';
        }
    </script>
</body>
</html>
