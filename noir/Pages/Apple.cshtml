@page
@model noir.Pages.AppleModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Аккаунт Apple</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #fff;
            color: #1d1d1f;
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        /* ─── Header ─── */
        .apple-header {
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            border-bottom: 1px solid #d2d2d7;
            position: sticky;
            top: 0;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 100;
        }

        .apple-logo svg { display: block; }

        .header-signin {
            font-size: 14px;
            font-weight: 400;
            color: #0071e3;
            text-decoration: none;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
        }
        .header-signin:hover { text-decoration: underline; }

        /* ─── Main ─── */
        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .card {
            width: 100%;
            max-width: 380px;
            text-align: center;
        }

        .app-icon {
            width: 64px;
            height: 64px;
            border-radius: 14px;
            background: #1d1d1f;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.15);
        }

        .app-icon span {
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
        }

        .card-title {
            font-size: 19px;
            font-weight: 500;
            color: #1d1d1f;
            line-height: 1.4;
            margin-bottom: 24px;
            max-width: 280px;
            margin-left: auto;
            margin-right: auto;
        }

        /* ─── Steps ─── */
        .step { display: none; }
        .step.active { display: block; }

        /* ─── Fields ─── */
        .field-group {
            border: 1px solid #d2d2d7;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 16px;
            background: #fff;
        }

        .field-group input {
            width: 100%;
            height: 48px;
            padding: 0 16px;
            font-size: 17px;
            font-family: inherit;
            color: #1d1d1f;
            background: transparent;
            border: none;
            outline: none;
            -webkit-appearance: none;
        }

        .field-group input::placeholder { color: #aeaeb2; }

        .field-group input + input {
            border-top: 1px solid #d2d2d7;
        }

        .field-group input:focus {
            background: #f5f5f7;
        }

        /* ─── Forgot link ─── */
        .forgot-link {
            display: block;
            text-align: left;
            font-size: 14px;
            color: #0071e3;
            text-decoration: none;
            margin-bottom: 28px;
            margin-top: -8px;
        }
        .forgot-link:hover { text-decoration: underline; }

        /* ─── Trust notice ─── */
        .trust-notice {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            text-align: left;
            margin-bottom: 24px;
        }

        .trust-icon {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            margin-top: 2px;
        }

        .trust-text {
            font-size: 12px;
            color: #6e6e73;
            line-height: 1.5;
        }

        .trust-text a {
            color: #0071e3;
            text-decoration: none;
        }
        .trust-text a:hover { text-decoration: underline; }

        /* ─── Buttons ─── */
        .btn-row {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
        }

        .btn {
            flex: 1;
            height: 44px;
            border-radius: 980px;
            font-size: 15px;
            font-weight: 400;
            font-family: inherit;
            cursor: pointer;
            border: none;
            -webkit-appearance: none;
            transition: filter 0.15s;
        }

        .btn:active { filter: brightness(0.92); }

        .btn-primary {
            background: #0071e3;
            color: #fff;
        }
        .btn-primary:hover { background: #0077ed; }
        .btn-primary:disabled { background: #aeaeb2; cursor: not-allowed; }

        .btn-secondary {
            background: #1d1d1f;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            font-size: 14px;
        }
        .btn-secondary:hover { background: #2d2d2f; }

        .iphone-icon {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

        .iphone-caption {
            font-size: 12px;
            color: #6e6e73;
            text-align: center;
            margin-top: 8px;
        }

        /* ─── Error ─── */
        .error-msg {
            font-size: 13px;
            color: #ff3b30;
            text-align: left;
            margin-bottom: 12px;
            display: none;
        }
        .error-msg.visible { display: block; }

        /* ─── Footer ─── */
        footer {
            padding: 20px 24px;
            border-top: 1px solid #d2d2d7;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px 16px;
        }

        footer span, footer a {
            font-size: 12px;
            color: #6e6e73;
            text-decoration: none;
        }
        footer a:hover { text-decoration: underline; }
        footer .sep { color: #d2d2d7; }
    </style>
</head>
<body>

    <header class="apple-header">
        <!-- Apple logo (исправленный, нормальный) -->
        <div class="apple-logo">
            <svg width="20" height="24" viewBox="0 0 24 24" fill="#1d1d1f">
                <path d="M16.5 4.5c.8-1 1.3-2.3 1.2-3.5-1.2.1-2.6.8-3.5 1.8-.8.9-1.4 2.1-1.3 3.3 1.3.1 2.6-.6 3.6-1.6zM19 13.5c.1 2.5 2.2 3.4 2.3 3.4-.1.2-.4 1.2-1.2 2.4-.7 1.1-1.5 2.2-2.7 2.2-1.2 0-1.5-.7-2.9-.7-1.3 0-1.8.7-2.9.7s-2-.9-2.8-2.2c-1.5-2.2-2.6-6.3-1.1-9 .7-1.3 2-2.1 3.4-2.1 1.3 0 2.1.7 3.1.7 1 0 1.8-.8 3.2-.8 1.4 0 2.5.9 3.1 2.1-2 .9-2.9 2.5-2.9 4.3z"/>
            </svg>
        </div>
        <button class="header-signin" onclick="document.getElementById('step1').scrollIntoView()">Войти</button>
    </header>

    <main>
        <div class="card">

            <div class="app-icon">
                <span>noir</span>
            </div>

            <p class="card-title">Использовать Аккаунт Apple для входа в приложение «noir»</p>

            <!-- ── STEP 1: email / phone ── -->
            <div class="step active" id="step1">
                <div class="field-group">
                    <input type="text"
                           id="emailInput"
                           placeholder="E-mail или номер телефона"
                           autocomplete="off"
                           inputmode="email"
                           spellcheck="false"
                           autocapitalize="off">
                </div>

                <div class="error-msg" id="step1Error">Введите e-mail или номер телефона</div>

                <div class="trust-notice">
                    <svg class="trust-icon" viewBox="0 0 40 40" fill="none">
                        <circle cx="20" cy="20" r="20" fill="#e3e3e8"/>
                        <path d="M14 20a6 6 0 1 1 12 0" stroke="#aeaeb2" stroke-width="2" fill="none"/>
                        <circle cx="20" cy="25" r="5" fill="#aeaeb2"/>
                        <circle cx="26" cy="28" r="6" fill="#fff" stroke="#e3e3e8" stroke-width="1"/>
                        <path d="M23 28l2 2 4-4" stroke="#34c759" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <p class="trust-text">
                        При настройке функции «Вход с Apple» информация о Вашем взаимодействии с Apple и с этим устройством может использоваться компанией Apple для предотвращения мошенничества.
                        <a href="#">Как осуществляется управление данными…</a>
                    </p>
                </div>

                <div class="btn-row">
                    <button class="btn btn-primary" onclick="goToStep2()">Продолжить</button>
                    <button class="btn btn-secondary" onclick="loginWithiPhone()">
                        <svg class="iphone-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5">
                            <rect x="5" y="2" width="14" height="20" rx="2" ry="2" fill="none" stroke="white"/>
                            <line x1="12" y1="18" x2="12" y2="18" stroke="white" stroke-width="2"/>
                        </svg>
                        Войти с iPhone
                    </button>
                </div>
                <!-- iOS 17 надпись ПОД кнопкой, 1в1 как на скрине -->
                <p class="iphone-caption">Требуется устройство с iOS 17 или новее.</p>
            </div>

            <!-- ── STEP 2: password ── -->
            <div class="step" id="step2">
                <div class="field-group">
                    <input type="text"
                           id="emailDisplay"
                           readonly
                           style="color:#6e6e73; font-size:15px;">
                    <input type="password"
                           id="passwordInput"
                           placeholder="Пароль"
                           autocomplete="off">
                </div>

                <a href="#" class="forgot-link" onclick="return false;">Забыли пароль? ↗</a>

                <div class="error-msg" id="step2Error">Неверный пароль. Попробуйте ещё раз.</div>

                <div class="btn-row">
                    <button class="btn btn-primary" onclick="handleAppleLogin()">Войти</button>
                    <button class="btn btn-secondary" onclick="loginWithiPhone()">
                        <svg class="iphone-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5">
                            <rect x="5" y="2" width="14" height="20" rx="2" ry="2" fill="none" stroke="white"/>
                            <line x1="12" y1="18" x2="12" y2="18" stroke="white" stroke-width="2"/>
                        </svg>
                        Войти с iPhone
                    </button>
                </div>
                <!-- iOS 17 надпись ПОД кнопкой, 1в1 как на скрине -->
                <p class="iphone-caption">Требуется устройство с iOS 17 или новее.</p>
            </div>

        </div>
    </main>

    <footer>
        <span>© Apple Inc., 2026 г. Все права защищены.</span>
        <span class="sep">|</span>
        <a href="#">Политика конфиденциальности</a>
        <span class="sep">|</span>
        <a href="#">Использование cookies</a>
    </footer>

    <script>
        // Если уже залогинен — на главную
        if (sessionStorage.getItem('noir_user')) {
            window.location.href = '/';
        }

        document.getElementById('emailInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') goToStep2();
        });

        document.getElementById('passwordInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') handleAppleLogin();
        });

        function goToStep2() {
            var email = document.getElementById('emailInput').value.trim();
            var err = document.getElementById('step1Error');

            if (!email) {
                err.classList.add('visible');
                setTimeout(function() { err.classList.remove('visible'); }, 3000);
                return;
            }

            // Показываем email в шаге 2
            document.getElementById('emailDisplay').value = email;

            document.getElementById('step1').classList.remove('active');
            document.getElementById('step2').classList.add('active');
            setTimeout(function() {
                document.getElementById('passwordInput').focus();
            }, 50);
        }

        function handleAppleLogin() {
            var email = document.getElementById('emailInput').value.trim();
            var password = document.getElementById('passwordInput').value;
            var err = document.getElementById('step2Error');

            if (!password) {
                err.textContent = 'Введите пароль.';
                err.classList.add('visible');
                setTimeout(function() { err.classList.remove('visible'); }, 3000);
                return;
            }

            var user = {
                username: email,
                email: email,
                role: 'user',
                appleAuth: true,
                nickname: null,
                displayName: email
            };
            sessionStorage.setItem('noir_user', JSON.stringify(user));
            window.location.href = '/Nickname';
        }

        function loginWithiPhone() {
            var email = document.getElementById('emailInput').value.trim() ||
                        document.getElementById('emailDisplay').value.trim();

            if (!email) {
                var val = document.getElementById('emailInput').value.trim();
                if (!val) {
                    document.getElementById('emailInput').focus();
                    var err = document.getElementById('step1Error');
                    err.textContent = 'Введите e-mail или номер телефона';
                    err.classList.add('visible');
                    setTimeout(function() { err.classList.remove('visible'); }, 3000);
                    return;
                }
                email = val;
            }

            var user = {
                username: email,
                email: email,
                role: 'user',
                appleAuth: true,
                appleDevice: true,
                nickname: null,
                displayName: email
            };
            sessionStorage.setItem('noir_user', JSON.stringify(user));
            window.location.href = '/Nickname';
        }
    </script>
</body>
</html>