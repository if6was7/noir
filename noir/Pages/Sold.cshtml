@page
@using System.Linq
@functions {
    public class SoldItem
    {
        public int Id { get; set; }
        public string Title { get; set; }
        public int Price { get; set; }
        public string Desc { get; set; }
        public string[] Categories { get; set; }
        public string BuyerName { get; set; }
        public string SoldDate { get; set; }
        public int FinalPrice { get; set; }
    }

    public SoldItem[] GetAllItems()
    {
        return new[] {
            new SoldItem { Id = 101, Title = "opium heavy glass bottle", Price = 3200, Desc = "A dense hand-blown glass vessel once used in an opium trading post, circa 1880.", Categories = new[] { "Glass", "Antique" }, BuyerName = "anonymous", SoldDate = "14 Feb 2026", FinalPrice = 3200 },
            new SoldItem { Id = 102, Title = "ivory chess set (19th c.)", Price = 12500, Desc = "A complete 32-piece chess set hand-carved from elephant ivory by a Calcutta artisan.", Categories = new[] { "Ivory", "Games" }, BuyerName = "mr. blackwell", SoldDate = "02 Mar 2026", FinalPrice = 14000 },
            new SoldItem { Id = 103, Title = "faded polaroid collection", Price = 850, Desc = "87 polaroids from an unknown photographer, spanning 1974 to 1991.", Categories = new[] { "Photography", "Vintage" }, BuyerName = "anonymous", SoldDate = "19 Mar 2026", FinalPrice = 850 },
            new SoldItem { Id = 104, Title = "brass astronomical clock", Price = 45000, Desc = "A 17th-century brass orrery with original hand-engraved celestial markings.", Categories = new[] { "Horology", "Brass" }, BuyerName = "lady v.", SoldDate = "01 Apr 2026", FinalPrice = 52000 }
        };
    }

    public SoldItem GetItem()
    {
        var all = GetAllItems();
        int.TryParse(Request.Query["id"], out int id);
        return all.FirstOrDefault(i => i.Id == id) ?? all[0];
    }
}
@{
    Layout = null;
    var item = GetItem();
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>noir — @item.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Cinzel:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --bg: #ffffff; --text-main: #000000; --light-gray: #fdfdfd; --sold-red: #660000; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg); color: var(--text-main); font-family: 'Goudy Old Style', serif; -webkit-font-smoothing: antialiased; }
        
        header { background-color: #000; height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 60px; position: sticky; top: 0; z-index: 1000; }
        .brand { font-family: 'Cinzel', serif; font-size: 2.8rem; letter-spacing: 5px; text-transform: lowercase; color: #fff; text-decoration: none; line-height: 1; }
        nav { display: flex; gap: 60px; }
        nav a { text-decoration: none; color: #fff; font-size: 1.5rem; opacity: 0.45; transition: 0.4s; }
        nav a:hover { opacity: 1; }
        .admin-label { color: #fff; font-family: 'Montserrat'; font-size: 0.7rem; letter-spacing: 2px; opacity: 0.5; justify-self: end; text-transform: uppercase; }

        .product-container { max-width: 1400px; margin: 80px auto; padding: 0 60px; display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
        
        .product-image { width: 100%; aspect-ratio: 3 / 4; background-color: var(--light-gray); border: 1px solid #efefef; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
        .product-image span { font-family: 'Cinzel', serif; font-size: 22rem; color: #f0f0f0; position: absolute; bottom: -50px; right: -30px; pointer-events: none; }

        /* Диагональная плашка SOLD */
        .sold-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 10;
            pointer-events: none;
        }
        .sold-ribbon {
            position: absolute;
            top: 0; left: 0;
            background: var(--sold-red);
            color: #fff;
            padding: 12px 25px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 600;
        }

        .product-details { display: flex; flex-direction: column; }
        .lot-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .lot-tag { font-family: 'Montserrat', sans-serif; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 3px; color: #000; font-weight: 600; }

        .product-title { font-size: 3.5rem; margin: 0 0 25px 0; text-transform: lowercase; line-height: 1.1; font-weight: normal; }
        .product-desc { font-family: 'Montserrat', sans-serif; font-size: 1.05rem; line-height: 1.8; color: #333; font-weight: 300; margin-bottom: 40px; }

        /* Блок продажи */
        .sold-info-box {
            border: 1px solid #000;
            padding: 30px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .sold-field { display: flex; flex-direction: column; gap: 8px; }
        .sold-label {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.55rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            opacity: 0.4;
        }
        .sold-value {
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            font-weight: 600;
            text-transform: lowercase;
        }
        .sold-value.price {
            font-size: 1.3rem;
            color: var(--sold-red);
        }

        /* Нижняя плашка вместо кнопки */
        .closed-box {
            background: #f5f5f5;
            width: 100%;
            height: 90px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 30px;
            gap: 15px;
        }
        .closed-line {
            width: 40px;
            height: 1px;
            background: #999;
        }
        .closed-text {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 5px;
            color: #999;
        }

        .category-wrap { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 40px; border-top: 1px solid #eee; padding-top: 30px; }
        .cat-tag { font-family: 'Montserrat', sans-serif; font-size: 0.6rem; text-transform: uppercase; padding: 6px 15px; border: 1px solid #eee; color: #999; text-decoration: none; transition: 0.3s; }
        .cat-tag:hover { border-color: #000; color: #000; }

        .footer {
            max-width: 1400px;
            margin: 120px auto 0;
            padding: 60px 60px 60px;
            border-top: 1px solid #000;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
        }
        .footer-brand { font-family: 'Cinzel', serif; font-size: 1.2rem; letter-spacing: 5px; text-transform: lowercase; }
        .footer-copy { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: center; }
        .footer-tagline { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: right; }
    </style>
</head>
<body>
    <header>
        <a href="/" class="brand">noir</a>
        <nav>
            <a href="/">Catalog</a>
            <a href="/Auction">Auction</a>
            <a href="/Archive" class="active">Archive</a>
            <a href="/Upload">Upload</a>
        </nav>
        <div class="admin-label">administrator</div>
    </header>

    <main class="product-container">
        <div class="product-image">
            <div class="sold-ribbon">Sold Out</div>
            <span>@item.Id</span>
        </div>

        <div class="product-details">
            <div class="lot-header">
                <span class="lot-tag">Archive Ref: 00@item.Id</span>
            </div>

            <h1 class="product-title">@item.Title</h1>
            <p class="product-desc">@item.Desc</p>

            <div class="sold-info-box">
                <div class="sold-field">
                    <span class="sold-label">Acquired by</span>
                    <span class="sold-value">@item.BuyerName</span>
                </div>
                <div class="sold-field">
                    <span class="sold-label">Date of sale</span>
                    <span class="sold-value">@item.SoldDate</span>
                </div>
                <div class="sold-field">
                    <span class="sold-label">Est. value</span>
                    <span class="sold-value">EUR @item.Price.ToString("N0")</span>
                </div>
                <div class="sold-field">
                    <span class="sold-label">Final price</span>
                    <span class="sold-value price">EUR @item.FinalPrice.ToString("N0")</span>
                </div>
            </div>

            <div class="closed-box">
                <div class="closed-line"></div>
                <span class="closed-text">this lot is closed</span>
                <div class="closed-line"></div>
            </div>

            <div class="category-wrap">
                @foreach (var cat in item.Categories) { <a href="#" class="cat-tag">@cat</a> }
            </div>
        </div>
    </main>

    <footer class="footer">
        <span class="footer-brand">noir</span>
        <span class="footer-copy">© 2026 noir private collection. all rights reserved.</span>
        <span class="footer-tagline">objects of consequence</span>
    </footer>
</body>
</html>