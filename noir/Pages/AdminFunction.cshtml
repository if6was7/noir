@page
@model noir.Pages.AdminFunctionModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>noir — admin panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Cinzel:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --bg: #ffffff; --text-main: #000000; --header-bg: #000000; --accent-purple: #a855f7; --accent-dim: #7c3aed; --admin-gold: #c9a84c; --admin-gold-dim: #a07c2a; --danger: #c0392b; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg); color: var(--text-main); font-family: 'Goudy Old Style', serif; -webkit-font-smoothing: antialiased; min-height: 100vh; }
        header { background-color: var(--header-bg); height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 60px; position: sticky; top: 0; z-index: 1000; }
        .brand-wrapper { display: inline-flex; align-items: flex-end; gap: 5px; text-decoration: none; cursor: pointer; }
        .brand { font-family: 'Cinzel', serif; font-size: 2.8rem; letter-spacing: 5px; text-transform: lowercase; color: #fff; line-height: 1; }
        .plus-sticker { display: none; color: var(--accent-purple); font-family: 'Montserrat', sans-serif; font-size: 0.5rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; line-height: 1; margin-bottom: 10px; }
        nav { display: flex; gap: 60px; }
        nav a { text-decoration: none; color: #fff; font-size: 1.5rem; opacity: 0.45; transition: 0.3s; cursor: pointer; }
        nav a:hover, nav a.active { opacity: 1; }
        .header-right { justify-self: end; display: flex; align-items: center; gap: 18px; }
        .header-avatar-wrap { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .header-avatar { width: 28px; height: 28px; border-radius: 50%; background: #000; border: 1px solid #2a2a2a; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; font-weight: 600; color: #fff; overflow: hidden; font-family: 'Cinzel', serif; transition: border-color 0.3s; }
        .header-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .header-avatar.plus-border { border-color: var(--accent-purple); }
        .header-avatar.gold-border { border-color: var(--admin-gold); }
        .header-username { font-family: 'Montserrat'; font-size: 0.65rem; letter-spacing: 2px; color: #fff; opacity: 0.5; text-transform: uppercase; }
        .logout-btn { font-family: 'Montserrat'; font-size: 0.6rem; letter-spacing: 2px; text-transform: uppercase; color: #fff; opacity: 0.3; background: none; border: none; cursor: pointer; transition: 0.2s; padding: 0; }
        .logout-btn:hover { opacity: 1; }
        .container { max-width: 1000px; margin: 0 auto; padding: 60px 40px 100px; font-family: 'Montserrat', sans-serif; }
        .page-header { display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid #000; padding-bottom: 24px; margin-bottom: 50px; }
        .page-eyebrow { font-size: 0.5rem; text-transform: uppercase; letter-spacing: 5px; opacity: 0.3; margin-bottom: 10px; }
        .page-title-wrap { display: flex; align-items: center; gap: 16px; }
        .page-title { font-family: 'Cinzel', serif; font-size: 2.4rem; letter-spacing: 6px; text-transform: uppercase; font-weight: 700; }
        .admin-crown { font-size: 0.45rem; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--admin-gold); border: 1px solid var(--admin-gold); padding: 4px 10px; line-height: 1.7; }
        .superadmin-note { font-size: 0.52rem; letter-spacing: 2px; opacity: 0.35; margin-top: 8px; text-transform: uppercase; }
        .search-wrap { position: relative; margin-bottom: 40px; }
        .search-input { width: 100%; border: none; border-bottom: 1px solid #ddd; padding: 14px 0 12px 0; font-family: 'Montserrat', sans-serif; font-size: 0.85rem; color: #000; background: transparent; outline: none; transition: border-color 0.25s; letter-spacing: 1px; }
        .search-input:focus { border-bottom-color: #000; }
        .search-input::placeholder { color: #ccc; font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; }
        .section-block { margin-bottom: 50px; }
        .section-label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; margin-top: 14px; }
        .section-label { font-size: 0.5rem; text-transform: uppercase; letter-spacing: 4px; opacity: 0.35; font-weight: 600; }
        .section-count { font-size: 0.5rem; letter-spacing: 2px; opacity: 0.25; }
        .user-list { border-top: 1px solid #eee; }
        .user-row { display: flex; align-items: center; gap: 20px; padding: 18px 0; border-bottom: 1px solid #eee; transition: background 0.15s; }
        .user-row:hover { background: #fafafa; margin: 0 -20px; padding: 18px 20px; }
        .user-avatar-small { width: 38px; height: 38px; border-radius: 50%; background: #000; border: 2px solid #000; display: flex; align-items: center; justify-content: center; font-family: 'Cinzel'; font-size: 0.85rem; color: #fff; overflow: hidden; flex-shrink: 0; transition: border-color 0.3s; }
        .user-avatar-small img { width: 100%; height: 100%; object-fit: cover; }
        .user-avatar-small.plus-ring { border-color: var(--accent-purple); }
        .user-avatar-small.gold-ring { border-color: var(--admin-gold); }
        .user-info { flex: 1; }
        .user-name-row { display: flex; align-items: center; gap: 10px; margin-bottom: 3px; }
        .user-name { font-size: 0.85rem; font-weight: 600; }
        .badge { font-size: 0.42rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; padding: 2px 8px; line-height: 1.7; border-radius: 2px; flex-shrink: 0; }
        .badge-admin { color: var(--admin-gold); border: 1px solid var(--admin-gold); }
        .badge-superadmin { color: var(--admin-gold); border: 1px solid var(--admin-gold); background: rgba(201,168,76,0.08); }
        .badge-plus { color: var(--accent-purple); border: 1px solid var(--accent-purple); }
        .user-meta { font-size: 0.6rem; opacity: 0.35; text-transform: uppercase; letter-spacing: 1px; }
        .user-actions { display: flex; gap: 8px; flex-shrink: 0; }
        
        /* ── ФИКС КНОПОК: hover текст белый ── */
        .action-btn-sm { 
            padding: 7px 16px; 
            border: 1px solid #000; 
            background: #fff; 
            color: #000;
            font-family: 'Montserrat'; 
            font-size: 0.55rem; 
            font-weight: 600; 
            text-transform: uppercase; 
            letter-spacing: 1.5px; 
            cursor: pointer; 
            transition: all 0.2s ease; 
            white-space: nowrap; 
        }
        .action-btn-sm:hover { 
            background: #000; 
            color: #fff; 
            border-color: #000;
        }
        
        .action-btn-sm.promote { 
            border-color: var(--admin-gold); 
            color: var(--admin-gold); 
        }
        .action-btn-sm.promote:hover { 
            background: var(--admin-gold); 
            color: #fff; 
            border-color: var(--admin-gold);
        }
        
        .action-btn-sm.demote { 
            border-color: var(--danger); 
            color: var(--danger); 
        }
        .action-btn-sm.demote:hover { 
            background: var(--danger); 
            color: #fff; 
            border-color: var(--danger);
        }
        
        .action-btn-sm.delete-btn {
            border-color: var(--danger);
            color: var(--danger);
        }
        .action-btn-sm.delete-btn:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }
        
        .action-btn-sm:disabled { 
            opacity: 0.2; 
            cursor: not-allowed; 
            background: #fff !important; 
            color: #000 !important; 
            border-color: #ccc !important;
        }
        .action-btn-sm:disabled:hover {
            background: #fff !important;
            color: #000 !important;
            border-color: #ccc !important;
        }
        
        .empty-row { padding: 40px 0; text-align: center; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 4px; opacity: 0.2; border-bottom: 1px solid #eee; }
        .toast { position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%) translateY(20px); background: #000; color: #fff; font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; padding: 14px 28px; opacity: 0; transition: opacity 0.3s, transform 0.3s; pointer-events: none; z-index: 9000; }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .footer-main { border-top: 1px solid #000; padding: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; background: #fff; }
        .footer-brand { font-family: 'Cinzel', serif; font-size: 1.3rem; letter-spacing: 5px; text-transform: lowercase; }
        .footer-copy { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: center; }
        .footer-tagline { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: right; }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()

    <header>
        <div class="brand-wrapper" onclick="window.location.href='/'">
            <span class="brand">noir</span>
            @if (Model.CurrentUser?.HasPlus == true || Model.CurrentUser?.Role == "admin" || Model.CurrentUser?.Role == "superadmin")
            {
                <span id="headerPlus" class="plus-sticker" style="display:inline">plus</span>
            }
            else
            {
                <span id="headerPlus" class="plus-sticker">plus</span>
            }
        </div>
        <nav>
            <a onclick="window.location.href='/'">Catalog</a>
            <a onclick="requireAuth('/Auction')">Auction</a>
            <a onclick="requireAuth('/Archive')">Archive</a>
            <a onclick="requireAuth('/Upload')">Upload</a>
        </nav>
        <div class="header-right">
            @if (Model.CurrentUser != null)
            {
                <div class="header-avatar-wrap" onclick="location.href='/Account'">
                    <div class="header-avatar @(Model.CurrentUser.Role == "superadmin" ? "gold-border" : Model.CurrentUser.HasPlus ? "plus-border" : "")" id="headerAvatar">
                        @if (!string.IsNullOrEmpty(Model.CurrentUser.AvatarUrl))
                        {
                            <img src="@Model.CurrentUser.AvatarUrl" alt="" onerror="this.style.display='none'" />
                        }
                        else if (Model.CurrentUser.Username == "if6was7")
                        {
                            <span style="font-size:0.7rem; font-weight:bold;">@Model.CurrentUser.Username.Substring(0,1).ToUpper()</span>
                        }
                        else
                        {
                            <img src="/images/avatar/@(Model.CurrentUser.Username).jpg" onerror="tryNextExt(this, '@Model.CurrentUser.Username')" alt="" />
                        }
                    </div>
                    <span class="header-username" id="headerUsername">@(Model.CurrentUser.Username == "if6was7" ? Model.CurrentUser.Username : (string.IsNullOrEmpty(Model.CurrentUser.Nickname) ? Model.CurrentUser.Username : Model.CurrentUser.Nickname))</span>
                </div>
                <button class="logout-btn" onclick="logout()">exit</button>
            }
            else
            {
                <div class="header-avatar-wrap" onclick="location.href='/Log_In'">
                    <div class="header-avatar" id="headerAvatar" data-role="guest"></div>
                    <span class="header-username" id="headerUsername">guest</span>
                </div>
                <button class="logout-btn" onclick="location.href='/Log_In'">sign in</button>
            }
        </div>
    </header>

    <main class="container">
        <div class="page-header">
            <div class="page-header-left">
                <div class="page-eyebrow">noir private collection</div>
                <div class="page-title-wrap">
                    <h1 class="page-title">Admin Panel</h1>
                    <span class="admin-crown">Admin</span>
                </div>
                <div class="superadmin-note">Only @@if6was7 can manage administrators</div>
            </div>
        </div>

        <input type="text" class="search-input" id="searchInput" placeholder="Search users..." oninput="renderAll()">

        <div class="section-block">
            <div class="section-label-row">
                <span class="section-label">Administrators</span>
                <span class="section-count" id="adminCount">@Model.AdminUsers.Count users</span>
            </div>
            <div class="user-list" id="adminList">
                @foreach (var u in Model.AdminUsers)
                {
                    var clean = u.Username.Replace("@", "");
                    var isSuper = u.Username == "if6was7" || u.Role == "superadmin";
                    <div class="user-row" data-username="@u.Username" data-search="@(u.Username + " " + (u.Email ?? "") + " " + (u.Nickname ?? ""))">
                        <div class="user-avatar-small @(isSuper ? "gold-ring" : (u.HasPlus ? "plus-ring" : ""))">
                            <img src="/images/avatar/@(clean).jpg" style="width:100%;height:100%;object-fit:cover;" onerror="tryNextExt(this, '@clean')" alt="">
                        </div>
                        <div class="user-info">
                            <div class="user-name-row">
                                <span class="user-name">@u.Username</span>
                                @if (isSuper) { <span class="badge badge-superadmin">Super Admin</span> }
                                else { <span class="badge badge-admin">Admin</span> }
                                @if (u.HasPlus) { <span class="badge badge-plus">plus</span> }
                            </div>
                            <div class="user-meta">@(u.Email ?? "—") · @(u.Nickname ?? u.Username)</div>
                        </div>
                        <div class="user-actions">
                            @if (isSuper)
                            {
                                <button class="action-btn-sm" disabled>Protected</button>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="ToggleAdmin" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="action-btn-sm demote">Revoke</button>
                                </form>
                                <form method="post" asp-page-handler="DeleteUser" style="display:inline;" onsubmit="return confirm('Delete user @u.Username? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="action-btn-sm delete-btn">Delete</button>
                                </form>
                            }
                        </div>
                    </div>
                }
                @if (!Model.AdminUsers.Any())
                {
                    <div class="empty-row">No administrators found</div>
                }
            </div>
        </div>

        <div class="section-block">
            <div class="section-label-row">
                <span class="section-label">All Users</span>
                <span class="section-count" id="userCount">@Model.AllUsers.Count users</span>
            </div>
            <div class="user-list" id="userList">
                @foreach (var u in Model.AllUsers)
                {
                    var clean = u.Username.Replace("@", "");
                    <div class="user-row" data-username="@u.Username" data-search="@(u.Username + " " + (u.Email ?? "") + " " + (u.Nickname ?? ""))">
                        <div class="user-avatar-small @(u.HasPlus ? "plus-ring" : "")">
                            <img src="/images/avatar/@(clean).jpg" style="width:100%;height:100%;object-fit:cover;" onerror="tryNextExt(this, '@clean')" alt="">
                        </div>
                        <div class="user-info">
                            <div class="user-name-row">
                                <span class="user-name">@u.Username</span>
                                @if (u.HasPlus) { <span class="badge badge-plus">plus</span> }
                            </div>
                            <div class="user-meta">@(u.Email ?? "—") · @(u.Nickname ?? u.Username)</div>
                        </div>
                        <div class="user-actions">
                            <form method="post" asp-page-handler="ToggleAdmin" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <button type="submit" class="action-btn-sm promote">Make Admin</button>
                            </form>
                            <form method="post" asp-page-handler="DeleteUser" style="display:inline;" onsubmit="return confirm('Delete user @u.Username? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <button type="submit" class="action-btn-sm delete-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                }
                @if (!Model.AllUsers.Any())
                {
                    <div class="empty-row">No users found</div>
                }
            </div>
        </div>
    </main>

    <footer class="footer-main">
        <span class="footer-brand">noir</span>
        <span class="footer-copy">© 2026 noir private collection. all rights reserved.</span>
        <span class="footer-tagline">objects of consequence</span>
    </footer>

    <div class="toast" id="toast"></div>

    <script>
        function logout() {
            fetch('/api/Auth/logout', { method: 'POST' })
                .then(function() {
                    sessionStorage.removeItem('noir_user');
                    window.location.href = '/';
                })
                .catch(function() {
                    sessionStorage.removeItem('noir_user');
                    window.location.href = '/';
                });
        }

        function requireAuth(url) {
            if (!sessionStorage.getItem('noir_user')) {
                window.location.href = '/Log_In';
            } else {
                window.location.href = url;
            }
        }

        function tryNextExt(img, username) {
            var extensions = ['.jpg', '.gif', '.png', '.jpeg', '.webp'];
            var currentSrc = img.src;
            var currentExt = currentSrc.substring(currentSrc.lastIndexOf('.'));
            var currentIdx = extensions.indexOf(currentExt);
            var nextIdx = currentIdx + 1;
            if (nextIdx < extensions.length) {
                img.src = '/images/avatar/' + username + extensions[nextIdx];
            } else {
                img.style.display = 'none';
                var parent = img.parentElement;
                parent.innerHTML = '<span style="font-size:0.85rem; font-weight:bold;">' + username.substring(0,1).toUpperCase() + '</span>';
            }
        }

        function showToast(msg) {
            var t = document.getElementById('toast');
            t.innerText = msg;
            t.classList.add('show');
            setTimeout(function() { t.classList.remove('show'); }, 2500);
        }

        function renderAll() {
            var query = (document.getElementById('searchInput').value || '').toLowerCase().trim();
            document.querySelectorAll('.user-row').forEach(function(row) {
                var search = (row.dataset.search || row.dataset.username || '').toLowerCase();
                row.style.display = (!query || search.indexOf(query) !== -1) ? 'flex' : 'none';
            });
        }

        @if (TempData["Message"] != null)
        {
            <text>showToast('@TempData["Message"]');</text>
        }
    </script>
</body>
</html>