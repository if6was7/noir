@page
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>noir — seller</title>
    <link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Cinzel:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { 
            --bg: #ffffff; 
            --text-main: #000000; 
            --header-bg: #000000; 
            --accent-purple: #a855f7;
            --admin-gold: #c9a84c;
            --danger: #c0392b;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { background-color: #000; }
        body { 
            background-color: var(--bg); 
            color: var(--text-main); 
            font-family: 'Goudy Old Style', serif; 
            -webkit-font-smoothing: antialiased; 
            min-height: 100vh;
            overscroll-behavior-y: none;
        }

        header { 
            background-color: var(--header-bg); 
            height: 60px; 
            display: grid; 
            grid-template-columns: 1fr auto 1fr; 
            align-items: center; 
            padding: 0 60px; 
            position: sticky; 
            top: 0; 
            z-index: 1000; 
        }
        .brand-wrapper { display: inline-flex; align-items: flex-end; gap: 5px; text-decoration: none; }
        .brand { font-family: 'Cinzel', serif; font-size: 2.8rem; letter-spacing: 5px; text-transform: lowercase; color: #fff; line-height: 1; }
        .plus-sticker { display: none; color: var(--accent-purple); font-family: 'Montserrat', sans-serif; font-size: 0.5rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; line-height: 1; margin-bottom: 10px; }
        nav { display: flex; gap: 60px; }
        nav a { text-decoration: none; color: #fff; font-size: 1.5rem; opacity: 0.45; transition: 0.3s; }
        nav a:hover { opacity: 1; }
        .header-right { justify-self: end; display: flex; align-items: center; gap: 18px; }
        .header-avatar-wrap { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .header-avatar { 
            width: 28px; height: 28px; border-radius: 50%; 
            background: #1a1a1a; border: 1px solid #2a2a2a;
            display: flex; align-items: center; justify-content: center; 
            font-size: 0.6rem; font-weight: 600; color: #fff;
            overflow: hidden; font-family: 'Cinzel', serif;
            transition: border-color 0.3s;
        }
        .header-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .header-avatar.plus-ring { border-color: var(--accent-purple); }
        .header-avatar.gold-ring { border-color: var(--admin-gold); }
        .header-username { font-family: 'Montserrat'; font-size: 0.65rem; letter-spacing: 2px; color: #fff; opacity: 0.5; text-transform: uppercase; }
        .logout-btn { font-family: 'Montserrat'; font-size: 0.6rem; letter-spacing: 2px; text-transform: uppercase; color: #fff; opacity: 0.3; background: none; border: none; cursor: pointer; transition: 0.2s; padding: 0; }
        .logout-btn:hover { opacity: 1; }

        /* ── Hero ── */
        .profile-hero { position: relative; width: 100%; height: 240px; background: #0d0d0d; overflow: visible; }
        .profile-hero-bg { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0; transition: opacity 0.5s; position: absolute; inset: 0; }
        .profile-hero-bg.loaded { opacity: 1; }
        .profile-hero::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 120px; background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.55)); pointer-events: none; }
        .hero-placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
        .hero-placeholder span { font-family: 'Montserrat'; font-size: 0.5rem; letter-spacing: 4px; text-transform: uppercase; color: #fff; opacity: 0.12; }
        .avatar-overlap { position: absolute; bottom: -50px; left: 60px; z-index: 10; }
        .avatar-circle { width: 100px; height: 100px; border-radius: 50%; border: 3px solid #fff; background: #1a1a1a; display: flex; align-items: center; justify-content: center; font-family: 'Cinzel'; font-size: 2.4rem; color: #fff; overflow: hidden; transition: border-color 0.3s; }
        .avatar-circle img { width: 100%; height: 100%; object-fit: cover; }
        .avatar-circle.plus-border { border-color: var(--accent-purple); }
        .avatar-circle.gold-border { border-color: var(--admin-gold); }

        /* ── Main ── */
        .container { max-width: 1200px; margin: 0 auto; padding: 0 40px 80px; font-family: 'Montserrat', sans-serif; }

        .user-info-row { display: flex; align-items: flex-end; gap: 24px; padding-top: 70px; padding-left: 20px; margin-bottom: 40px; }
        .user-text { flex: 1; }
        .user-name-line { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
        .user-name-line h1 { font-size: 1.6rem; font-weight: 600; }
        .plus-status-text { font-size: 0.6rem; letter-spacing: 2px; opacity: 0.3; text-transform: uppercase; }
        .plus-status-text.active { opacity: 1; color: var(--accent-purple); font-weight: 600; }
        .admin-badge-inline {
            font-size: 0.45rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase;
            color: var(--admin-gold); border: 1px solid var(--admin-gold);
            padding: 3px 9px; line-height: 1.7; display: none;
        }
        .stats-bar { display: flex; gap: 30px; font-size: 0.8rem; }
        .stat-item span { opacity: 0.5; margin-left: 4px; }

        .actions { display: flex; gap: 10px; align-items: center; padding-bottom: 4px; flex-wrap: wrap; }
        .btn { padding: 10px 22px; background: #fff; font-size: 0.7rem; font-weight: 600; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s; border: 1px solid #000; font-family: 'Montserrat'; white-space: nowrap; }
        .btn:hover { background: #000; color: #fff; }
        .btn.following { background: #000; color: #fff; }
        .btn.following:hover { background: #222; }
        .btn-outline {
            padding: 10px 22px; background: transparent; font-size: 0.7rem; font-weight: 600;
            cursor: pointer; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s;
            border: 1px solid #ccc; color: #888; font-family: 'Montserrat'; white-space: nowrap;
        }
        .btn-outline:hover { border-color: #000; color: #000; }

        /* ── Admin controls under name ── */
        .admin-controls {
            display: none;
            align-items: center;
            gap: 8px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid #f0f0f0;
            flex-wrap: wrap;
        }
        .admin-controls.visible { display: flex; }
        .admin-ctrl-label {
            font-size: 0.45rem; letter-spacing: 3px; text-transform: uppercase;
            color: var(--admin-gold); opacity: 0.6; font-weight: 600; margin-right: 4px;
        }
        .admin-ctrl-btn {
            font-family: 'Montserrat'; font-size: 0.48rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: 2px;
            padding: 7px 16px; border: 1px solid;
            cursor: pointer; transition: 0.2s; background: transparent;
        }
        .admin-ctrl-btn.rename { border-color: #ddd; color: #888; }
        .admin-ctrl-btn.rename:hover { border-color: #000; color: #000; }
        .admin-ctrl-btn.delete { border-color: #e0c0c0; color: var(--danger); opacity: 0.6; }
        .admin-ctrl-btn.delete:hover { border-color: var(--danger); opacity: 1; }

        /* ── Tabs ── */
        .tabs-nav { display: flex; gap: 35px; border-bottom: 1px solid #eee; }
        .tab-link { padding: 15px 5px; font-size: 0.9rem; color: #000; opacity: 0.4; cursor: pointer; position: relative; transition: 0.2s; user-select: none; }
        .tab-link:hover { opacity: 0.7; }
        .tab-link.active { opacity: 1; font-weight: 600; }
        .tab-link.active::after { content: ""; position: absolute; bottom: -1px; left: 0; width: 100%; height: 2px; background: #000; }
        .tab-content { display: none; margin-top: 40px; }
        .tab-content.active { display: block; }

        /* ── Listings ── */
        .listings-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 50px 30px; }
        .listing-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; cursor: pointer; }
        .lot-tag { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; color: #ccc; margin-bottom: 12px; }
        .image-wrapper { width: 100%; aspect-ratio: 3/4; background-color: #fdfdfd; display: flex; align-items: center; justify-content: center; position: relative; margin-bottom: 20px; overflow: hidden; border: 1px solid #eee; }
        .image-wrapper::before { content: ""; position: absolute; left: 0; bottom: 0; width: 2px; height: 100%; background-color: #000; transform: scaleY(0); transform-origin: bottom; transition: transform 0.6s cubic-bezier(0.215, 0.61, 0.355, 1); z-index: 5; }
        .listing-card:hover .image-wrapper::before { transform: scaleY(1); }
        .image-wrapper span { font-family: 'Cinzel', serif; font-size: 10rem; color: #f6f6f6; position: absolute; bottom: -30px; right: -20px; line-height: 1; }
        .listing-info { border-top: 1px solid #000; padding-top: 15px; }
        .listing-title { font-size: 1.5rem; margin: 0 0 8px 0; text-transform: lowercase; font-weight: normal; }
        .listing-price { font-family: 'Montserrat', sans-serif; font-size: 0.8rem; }
        .listing-price::before { content: "EUR "; font-weight: 400; opacity: 0.5; }

        .tab-empty { padding: 70px 0; text-align: center; }
        .tab-empty-label { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 5px; opacity: 0.25; margin-bottom: 12px; }
        .tab-empty-title { font-family: 'Cinzel'; font-size: 1.4rem; letter-spacing: 4px; opacity: 0.12; }

        /* ── Modals ── */
        .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 3000; display: none; align-items: center; justify-content: center; }
        .modal-backdrop.open { display: flex; }
        .modal { background: #fff; width: 440px; max-width: 95vw; padding: 44px 40px 36px; position: relative; }
        .modal-close { position: absolute; top: 16px; right: 20px; font-size: 1rem; cursor: pointer; opacity: 0.3; background: none; border: none; font-family: 'Montserrat'; transition: 0.2s; }
        .modal-close:hover { opacity: 1; }
        .modal-title { font-family: 'Cinzel'; font-size: 0.9rem; letter-spacing: 5px; text-transform: uppercase; margin-bottom: 8px; }
        .modal-subtitle { font-family: 'Montserrat'; font-size: 0.58rem; letter-spacing: 1px; opacity: 0.35; margin-bottom: 28px; text-transform: uppercase; }
        .modal-field-wrap { border-bottom: 1px solid #ddd; padding-bottom: 12px; margin-bottom: 24px; transition: border-color 0.25s; }
        .modal-field-wrap:focus-within { border-bottom-color: #000; }
        .modal-input { width: 100%; border: none; background: transparent; font-family: 'Montserrat'; font-size: 1rem; font-weight: 300; outline: none; color: #000; padding: 4px 0; }
        .modal-input::placeholder { color: #ddd; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; }
        .modal-btn { padding: 9px 24px; font-family: 'Montserrat'; font-size: 0.6rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; cursor: pointer; transition: 0.2s; border: 1px solid #000; background: #fff; }
        .modal-btn:hover { background: #000; color: #fff; }
        .modal-btn.primary { background: #000; color: #fff; }
        .modal-btn.primary:hover { background: #333; }
        .modal-btn.danger { border-color: var(--danger); color: var(--danger); background: #fff; }
        .modal-btn.danger:hover { background: var(--danger); color: #fff; }

        /* Delete confirmation */
        .delete-warning { font-family: 'Montserrat'; font-size: 0.65rem; line-height: 1.8; opacity: 0.5; margin-bottom: 28px; }
        .delete-warning strong { opacity: 1; color: var(--danger); }

        /* ── Deleted overlay ── */
        .deleted-overlay { display: none; position: fixed; inset: 0; z-index: 5000; background: #fff; align-items: center; justify-content: center; flex-direction: column; gap: 20px; }
        .deleted-overlay.show { display: flex; }
        .deleted-icon { font-family: 'Cinzel'; font-size: 3rem; opacity: 0.1; }
        .deleted-title { font-family: 'Cinzel'; font-size: 2rem; letter-spacing: 6px; text-transform: uppercase; }
        .deleted-sub { font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 4px; opacity: 0.3; }
        .deleted-back { display: inline-block; margin-top: 20px; padding: 14px 36px; border: 1px solid #000; font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 3px; text-decoration: none; color: #000; transition: 0.3s; }
        .deleted-back:hover { background: #000; color: #fff; }

        /* ── Toast ── */
        .toast { position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%) translateY(20px); background: #000; color: #fff; font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; padding: 14px 28px; opacity: 0; transition: opacity 0.3s, transform 0.3s; pointer-events: none; z-index: 9000; }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

        /* ── Footer ── */
        .page-spacer { height: 10vh; }
        .footer-main { border-top: 1px solid #000; padding: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; background: #fff; }
        .footer-brand { font-family: 'Cinzel', serif; font-size: 1.3rem; letter-spacing: 5px; text-transform: lowercase; }
        .footer-copy { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: center; }
        .footer-tagline { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: right; }
    </style>
</head>
<body>
    <header>
        <a href="/" class="brand-wrapper">
            <span class="brand">noir</span>
            <span id="headerPlus" class="plus-sticker">plus</span>
        </a>
        <nav>
            <a href="/">Catalog</a>
            <a href="/Auction">Auction</a>
            <a href="/Archive">Archive</a>
            <a href="/Upload">Upload</a>
        </nav>
        <div class="header-right">
            <div class="header-avatar-wrap" onclick="window.location.href='/Account'">
                <div class="header-avatar" id="headerAvatar"></div>
                <span class="header-username" id="headerUsername"></span>
            </div>
            <button class="logout-btn" onclick="logout()">exit</button>
        </div>
    </header>

    <div class="profile-hero">
        <img class="profile-hero-bg" id="sellerBanner" src="" alt="">
        <div class="hero-placeholder" id="heroPlaceholder">
            <span>noir private collection</span>
        </div>
        <div class="avatar-overlap">
            <div class="avatar-circle" id="sellerAvatar"></div>
        </div>
    </div>

    <main class="container">
        <div class="user-info-row">
            <div class="user-text">
                <div class="user-name-line">
                    <h1 id="sellerNameDisplay">—</h1>
                    <span id="sellerPlusStatus" class="plus-status-text">noir plus inactive</span>
                    <span id="adminBadgeInline" class="admin-badge-inline">Admin</span>
                </div>
                <div class="stats-bar">
                    <div class="stat-item"><b>42</b><span>Transactions</span></div>
                    <div class="stat-item"><b>★★★★★</b><span>Rating</span></div>
                    <div class="stat-item"><b id="followerCount">0</b><span>Followers</span></div>
                </div>

                <!-- Admin controls — only visible for admins viewing someone else's profile -->
                <div class="admin-controls" id="adminControls">
                    <span class="admin-ctrl-label">Admin</span>
                    <button class="admin-ctrl-btn rename" onclick="openRenameModal()">Rename</button>
                    <button class="admin-ctrl-btn delete" onclick="openDeleteModal()">Delete account</button>
                </div>
            </div>
            <div class="actions">
                <button class="btn" id="followBtn" onclick="toggleFollow()">Follow</button>
                <!-- View Account button — visible only when viewing your own seller page (if6was7 viewing if6was7) -->
                <button class="btn-outline" id="viewAccountBtn" style="display:none;" onclick="window.location.href='/Account'">Edit Profile</button>
            </div>
        </div>

        <nav class="tabs-nav">
            <div class="tab-link active" data-tab="listings">Listings</div>
            <div class="tab-link" data-tab="reviews">Reviews</div>
        </nav>

        <div class="tab-content active" id="tab-listings">
            <div class="listings-grid" id="listingsGrid"></div>
            <div class="tab-empty" id="listingsEmpty" style="display:none;">
                <div class="tab-empty-label">no listings yet</div>
                <div class="tab-empty-title">Nothing for sale</div>
            </div>
        </div>

        <div class="tab-content" id="tab-reviews">
            <div class="tab-empty">
                <div class="tab-empty-label">no feedback yet</div>
                <div class="tab-empty-title">No Reviews</div>
            </div>
        </div>

        <div class="page-spacer"></div>
    </main>

    <footer class="footer-main">
        <span class="footer-brand">noir</span>
        <span class="footer-copy">© 2026 noir private collection. all rights reserved.</span>
        <span class="footer-tagline">objects of consequence</span>
    </footer>

    <!-- Rename modal -->
    <div class="modal-backdrop" id="renameModal">
        <div class="modal">
            <button class="modal-close" onclick="closeRenameModal()">✕</button>
            <div class="modal-title">Rename user</div>
            <div class="modal-subtitle" id="renameSubtitle">Current: —</div>
            <div class="modal-field-wrap">
                <input type="text" class="modal-input" id="newUsernameInput" placeholder="New username">
            </div>
            <div class="modal-actions">
                <button class="modal-btn" onclick="closeRenameModal()">Cancel</button>
                <button class="modal-btn primary" onclick="saveRename()">Save</button>
            </div>
        </div>
    </div>

    <!-- Delete confirmation modal -->
    <div class="modal-backdrop" id="deleteModal">
        <div class="modal">
            <button class="modal-close" onclick="closeDeleteModal()">✕</button>
            <div class="modal-title">Delete account</div>
            <div class="modal-subtitle" id="deleteSubtitle">—</div>
            <div class="delete-warning">
                This action is <strong>irreversible</strong>. The account and all associated data will be permanently removed from the system.
            </div>
            <div class="modal-actions">
                <button class="modal-btn" onclick="closeDeleteModal()">Cancel</button>
                <button class="modal-btn danger" onclick="confirmDelete()">Delete permanently</button>
            </div>
        </div>
    </div>

    <!-- Deleted overlay -->
    <div class="deleted-overlay" id="deletedOverlay">
        <div class="deleted-icon">✕</div>
        <div class="deleted-title">Account Deleted</div>
        <div class="deleted-sub" id="deletedSubText">The account has been removed</div>
        <a href="/" class="deleted-back">Return to Catalog</a>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        var ALL_ITEMS = [
            { id: 1,  title: "minimalist ceramic bowl",  price: 450,    isAuction: false },
            { id: 2,  title: "vintage leather chair",    price: 850,    isAuction: false },
            { id: 3,  title: "niche perfume set",        price: 1800,   isAuction: false },
            { id: 4,  title: "rare vinyl collection",    price: 4200,   isAuction: false },
            { id: 5,  title: "silver mechanical watch",  price: 9500,   isAuction: false },
            { id: 6,  title: "renaissance oil canvas",   price: 65000,  isAuction: false },
            { id: 7,  title: "rare private island map",  price: 150000, isAuction: true  },
            { id: 8,  title: "the celestial sphere",     price: 740000, isAuction: false },
            { id: 10, title: "ancient marble bust",      price: 85000,  isAuction: true  },
            { id: 11, title: "viking iron sword",        price: 32000,  isAuction: true  },
            { id: 12, title: "dynasty ritual vessel",    price: 120000, isAuction: true  },
            { id: 13, title: "gothic cathedral key",     price: 15000,  isAuction: true  },
            { id: 14, title: "ottoman silk tapestry",    price: 47000,  isAuction: true  },
            { id: 15, title: "venetian poison ring",     price: 22000,  isAuction: true  },
            { id: 16, title: "aztec obsidian blade",     price: 68000,  isAuction: true  },
            { id: 17, title: "czarist fabergé fragment", price: 310000, isAuction: true  }
        ];

        var PLUS_SELLERS = ["if6was7"];
        var SUPERADMIN = '@@if6was7';
        var currentSellerName = '';

        function isSellerPlus(username) { return PLUS_SELLERS.indexOf(username.toLowerCase()) !== -1; }

        function getAdmins() { return JSON.parse(localStorage.getItem('noir_admins') || '["@@if6was7"]'); }

        (function init() {
            var raw = sessionStorage.getItem('noir_user');
            if (!raw) { window.location.href = '/Log_In'; return; }
            var viewer = JSON.parse(raw);

            var viewerOriginal = viewer.username || "";
            var viewerClean = viewerOriginal.replace('@@', '').toLowerCase();

            var params = new URLSearchParams(window.location.search);
            currentSellerName = (params.get('username') || '').replace('@@', '').toLowerCase();

            if (!currentSellerName) {
                window.location.href = '/Account';
                return;
            }

            // If viewing your own seller page, show Edit Profile button
            var isOwnProfile = (currentSellerName === viewerClean);
            if (isOwnProfile) {
                document.getElementById('viewAccountBtn').style.display = 'inline-block';
            }

            // Header
            var ha = document.getElementById('headerAvatar');
            var haImg = document.createElement('img');
            haImg.src = '/images/avatar/' + viewerClean + '.jpg';
            haImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
            haImg.onerror = function() { ha.removeChild(haImg); ha.innerText = viewerClean.charAt(0).toUpperCase(); };
            ha.appendChild(haImg);
            document.getElementById('headerUsername').innerText = viewerOriginal;

            var viewerIsSuperAdmin = (viewerOriginal === SUPERADMIN);
            var viewerIsPlus = viewerIsSuperAdmin || viewer.hasPlus === true || viewer.hasPlus === "true";

            // Header border priority: gold for superadmin
            if (viewerIsSuperAdmin) {
                ha.classList.add('gold-ring');
            } else if (viewerIsPlus) {
                ha.classList.add('plus-ring');
            }

            if (viewerIsPlus) { document.getElementById('headerPlus').style.display = 'inline'; }

            // Seller avatar
            var sa = document.getElementById('sellerAvatar');
            var saImg = document.createElement('img');
            saImg.src = '/images/avatar/' + currentSellerName + '.jpg';
            saImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
            saImg.onerror = function() { sa.removeChild(saImg); sa.innerText = currentSellerName.charAt(0).toUpperCase(); };
            sa.appendChild(saImg);

            // Check deleted accounts
            var deletedAccounts = JSON.parse(localStorage.getItem('noir_deleted_accounts') || '[]');
            if (deletedAccounts.indexOf(currentSellerName) !== -1) {
                document.getElementById('deletedOverlay').classList.add('show');
                document.getElementById('deletedSubText').innerText = '@@' + currentSellerName + ' has been removed';
                return;
            }

            // Check renamed accounts
            var renames = JSON.parse(localStorage.getItem('noir_renamed_accounts') || '{}');
            var displayName = renames[currentSellerName] || currentSellerName;

            // Check if seller is admin
            var sellerIsSuperAdmin = (currentSellerName === 'if6was7');
            var sellerIsAdmin = sellerIsSuperAdmin || getAdmins().indexOf('@@' + currentSellerName) !== -1;

            // Banner (plus sellers)
            if (isSellerPlus(currentSellerName)) {
                var banner = document.getElementById('sellerBanner');
                banner.src = '/images/avatar/' + currentSellerName + '_banner.jpg';
                banner.onload = function() { this.classList.add('loaded'); document.getElementById('heroPlaceholder').style.display = 'none'; };
                var st = document.getElementById('sellerPlusStatus');
                st.innerText = 'noir plus member';
                st.classList.add('active');
            }

            // ── BORDER PRIORITY: Admin gold > Plus purple ──
            if (sellerIsSuperAdmin) {
                sa.classList.add('gold-border');
            } else if (isSellerPlus(currentSellerName)) {
                sa.classList.add('plus-border');
            }

            // Show admin badge for admin sellers
            if (sellerIsAdmin) {
                document.getElementById('adminBadgeInline').style.display = 'inline-block';
            }

            document.getElementById('sellerNameDisplay').innerText = '@@' + displayName;
            document.title = 'noir — @@' + displayName;

            // Follow state
            var followKey = 'noir_follow_' + currentSellerName;
            updateFollowBtn(sessionStorage.getItem(followKey) === '1');

            // Admin check — show controls if viewer is admin AND viewing someone else's profile
            var admins = getAdmins();
            var viewerIsAdmin = admins.indexOf(viewer.username) !== -1;
            if (viewerIsAdmin && !isOwnProfile) {
                document.getElementById('adminControls').classList.add('visible');
                document.getElementById('renameSubtitle').innerText = 'Current: @@' + displayName;
                document.getElementById('deleteSubtitle').innerText = 'User: @@' + displayName;
            }

            // Listings
            var grid = document.getElementById('listingsGrid');
            ALL_ITEMS.forEach(function(item) {
                var card = document.createElement('a');
                card.href = '/Product?id=' + item.id;
                card.className = 'listing-card';
                card.innerHTML =
                    '<span class="lot-tag">Archive Ref: 00' + item.id + '</span>' +
                    '<div class="image-wrapper"><span>' + item.id + '</span></div>' +
                    '<div class="listing-info">' +
                        '<h3 class="listing-title">' + item.title + '</h3>' +
                        '<div class="listing-price">' + item.price.toLocaleString('de-DE') + '</div>' +
                    '</div>';
                grid.appendChild(card);
            });
        })();

        // ── Tabs ──
        document.querySelectorAll('.tab-link').forEach(function(link) {
            link.addEventListener('click', function() {
                document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active'); });
                document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });
                this.classList.add('active');
                document.getElementById('tab-' + this.dataset.tab).classList.add('active');
            });
        });

        // ── Follow ──
        function toggleFollow() {
            var followKey = 'noir_follow_' + currentSellerName;
            var isFollowing = sessionStorage.getItem(followKey) === '1';
            isFollowing = !isFollowing;
            sessionStorage.setItem(followKey, isFollowing ? '1' : '0');
            updateFollowBtn(isFollowing);
            var fc = document.getElementById('followerCount');
            fc.innerText = isFollowing ? parseInt(fc.innerText || 0) + 1 : Math.max(0, parseInt(fc.innerText || 0) - 1);
        }
        function updateFollowBtn(following) {
            var btn = document.getElementById('followBtn');
            btn.innerText = following ? 'Following' : 'Follow';
            following ? btn.classList.add('following') : btn.classList.remove('following');
        }

        // ── Admin: Rename ──
        function openRenameModal() {
            document.getElementById('newUsernameInput').value = '';
            document.getElementById('renameModal').classList.add('open');
            setTimeout(function() { document.getElementById('newUsernameInput').focus(); }, 80);
        }
        function closeRenameModal() { document.getElementById('renameModal').classList.remove('open'); }
        document.getElementById('renameModal').addEventListener('click', function(e) { if (e.target === this) closeRenameModal(); });

        function saveRename() {
            var newName = document.getElementById('newUsernameInput').value.trim();
            if (!newName || newName.length < 2) return;
            var renames = JSON.parse(localStorage.getItem('noir_renamed_accounts') || '{}');
            renames[currentSellerName] = newName;
            localStorage.setItem('noir_renamed_accounts', JSON.stringify(renames));
            document.getElementById('sellerNameDisplay').innerText = '@@' + newName;
            document.getElementById('renameSubtitle').innerText = 'Current: @@' + newName;
            document.getElementById('deleteSubtitle').innerText = 'User: @@' + newName;
            closeRenameModal();
            showToast('User renamed to @@' + newName);
        }

        // ── Admin: Delete ──
        function openDeleteModal() { document.getElementById('deleteModal').classList.add('open'); }
        function closeDeleteModal() { document.getElementById('deleteModal').classList.remove('open'); }
        document.getElementById('deleteModal').addEventListener('click', function(e) { if (e.target === this) closeDeleteModal(); });

        function confirmDelete() {
            var deleted = JSON.parse(localStorage.getItem('noir_deleted_accounts') || '[]');
            if (deleted.indexOf(currentSellerName) === -1) deleted.push(currentSellerName);
            localStorage.setItem('noir_deleted_accounts', JSON.stringify(deleted));

            // Also remove from registered users
            var reg = JSON.parse(localStorage.getItem('noir_registered_users') || '[]');
            reg = reg.filter(function(u) { return u.username.replace('@@','').toLowerCase() !== currentSellerName; });
            localStorage.setItem('noir_registered_users', JSON.stringify(reg));

            closeDeleteModal();
            document.getElementById('deletedOverlay').classList.add('show');
            document.getElementById('deletedSubText').innerText = '@@' + currentSellerName + ' has been permanently removed';
        }

        function logout() { sessionStorage.removeItem('noir_user'); window.location.href = '/Log_In'; }

        function showToast(msg) {
            var t = document.getElementById('toast');
            t.innerText = msg;
            t.classList.add('show');
            setTimeout(function() { t.classList.remove('show'); }, 2500);
        }
    </script>
</body>
</html>