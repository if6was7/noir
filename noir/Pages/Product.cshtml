@page
@using System.Linq
@functions {
    public class Item
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public int Price { get; set; }
        public string Desc { get; set; } = "";
        public string[] Categories { get; set; } = Array.Empty<string>();
        public bool IsAuction { get; set; }
        public string Seller { get; set; } = "if6was7";
        public string SellerRole { get; set; } = "regular";
        public int AuctionDurationMinutes { get; set; } = 5;
        public int AuctionDurationDays { get; set; } = 0;
    }

    public Item[] GetAllItems()
    {
        return new[] {
            new Item { Id = 1, Title = "minimalist ceramic bowl", Price = 450, Desc = "Hand-thrown organic stoneware with a matte white glaze.", Categories = new[] { "Ceramics", "Home Decor" }, Seller = "if6was7", SellerRole = "admin" },
            new Item { Id = 2, Title = "vintage leather chair", Price = 850, Desc = "Mid-century modern lounge chair in aged leather.", Categories = new[] { "Furniture", "Vintage" }, Seller = "if6was7", SellerRole = "admin" },
            new Item { Id = 3, Title = "niche perfume set", Price = 1800, Desc = "A curated selection of rare single-note fragrances from independent houses.", Categories = new[] { "Fragrance", "Niche" }, Seller = "if6was7", SellerRole = "admin" },
            new Item { Id = 4, Title = "rare vinyl collection", Price = 4200, Desc = "First pressings from obscure labels across three decades of underground music.", Categories = new[] { "Music", "Vintage" }, Seller = "if6was7", SellerRole = "admin" },
            new Item { Id = 5, Title = "silver mechanical watch", Price = 9500, Desc = "Hand-assembled Swiss movement in a brushed sterling silver case.", Categories = new[] { "Horology", "Silver" }, Seller = "if6was7", SellerRole = "admin" },
            new Item { Id = 6, Title = "renaissance oil canvas", Price = 65000, Desc = "A 16th-century oil painting attributed to a Flemish master's workshop.", Categories = new[] { "Painting", "Antique" }, Seller = "if6was7", SellerRole = "admin" },
            new Item { Id = 7, Title = "rare private island map", Price = 150000, Desc = "An original hand-drawn cartographic survey of an uncharted island, circa 1743.", Categories = new[] { "Cartography", "Rare" }, Seller = "if6was7", SellerRole = "admin" },
            new Item { Id = 8, Title = "the celestial sphere", Price = 740000, Desc = "A gold-plated astronomical instrument from the late 16th century.", Categories = new[] { "Gold", "Astronomy" }, Seller = "if6was7", SellerRole = "admin" },
            new Item { Id = 9, Title = "handcrafted obsidian dagger", Price = 3200, Desc = "A razor-sharp ceremonial blade knapped from volcanic obsidian, forged by master artisan tornadomart1.", Categories = new[] { "Weapons", "Obsidian" }, Seller = "tornadomart1", SellerRole = "regular" },
            new Item { Id = 10, Title = "ancient marble bust", Price = 85000, Desc = "A serene Roman-era fragment carved from Carrara marble.", Categories = new[] { "Sculpture", "Antique" }, IsAuction = true, AuctionDurationDays = 5 },
            new Item { Id = 11, Title = "viking iron sword", Price = 32000, Desc = "A preserved 9th-century blade recovered from a Norse burial site.", Categories = new[] { "Weapons", "Viking" }, IsAuction = true, AuctionDurationDays = 5 },
            new Item { Id = 12, Title = "dynasty ritual vessel", Price = 120000, Desc = "A bronze ceremonial vessel from the Chinese Han dynasty.", Categories = new[] { "Bronze", "Antique" }, IsAuction = true, AuctionDurationDays = 5 },
            new Item { Id = 13, Title = "gothic cathedral key", Price = 15000, Desc = "A wrought iron master key from a 13th-century French cathedral.", Categories = new[] { "Iron", "Gothic" }, IsAuction = true, AuctionDurationDays = 5 },
            new Item { Id = 14, Title = "ottoman silk tapestry", Price = 47000, Desc = "A hand-woven silk panel from the Ottoman imperial workshops, circa 1680.", Categories = new[] { "Textile", "Ottoman" }, IsAuction = true, AuctionDurationDays = 5 },
            new Item { Id = 15, Title = "venetian poison ring", Price = 22000, Desc = "A gold compartment ring attributed to 16th-century Venetian nobility.", Categories = new[] { "Jewelry", "Venetian" }, IsAuction = true, AuctionDurationDays = 5 },
            new Item { Id = 16, Title = "aztec obsidian blade", Price = 68000, Desc = "A razor-sharp ceremonial blade knapped from volcanic obsidian.", Categories = new[] { "Weapons", "Aztec" }, IsAuction = true, AuctionDurationDays = 5 },
            new Item { Id = 17, Title = "czarist fabergé fragment", Price = 310000, Desc = "A verified shard from a lost imperial Fabergé egg, with provenance documentation.", Categories = new[] { "Gold", "Imperial" }, IsAuction = true, AuctionDurationDays = 5 },
            new Item { Id = 18, Title = "imperial jade seal", Price = 95000, Desc = "A carved nephrite seal from the Qing imperial court, circa 1760.", Categories = new[] { "Jade", "Imperial" }, IsAuction = true, AuctionDurationDays = 5 }
        };
    }

    public Item GetItem()
    {
        var all = GetAllItems();
        int.TryParse(Request.Query["id"], out int id);
        return all.FirstOrDefault(i => i.Id == id) ?? all[0];
    }

    public string GetActionText(int price, bool isAuction, string title)
    {
        if (isAuction) return "Place a Bid";
        if (title == "the celestial sphere") return "touch the sun";
        if (price < 500)    return "Purchase Object";
        if (price < 1000)   return "Acquire Object";
        if (price < 2000)   return "Buy Niche";
        if (price < 5000)   return "Private Selection";
        if (price < 10000)  return "Investment Grade";
        if (price < 100000) return "Have Fun";
        return "Treat Yourself";
    }
}
@{
    Layout = null;
    var item = GetItem();
    var actionText = GetActionText(item.Price, item.IsAuction, item.Title);
    var recommendations = GetAllItems().Where(i => i.Id != item.Id && !i.IsAuction).OrderBy(x => Guid.NewGuid()).Take(3);
    var sellerUsername = item.Seller;
    var sellerIsPlus = item.SellerRole == "plus" || item.SellerRole == "admin";
    var sellerIsAdmin = item.SellerRole == "admin";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>noir — @item.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Cinzel:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { 
            --bg: #ffffff; --text-main: #000000; --light-gray: #fdfdfd;
            --auction-purple: #4b0082; --accent-purple: #a855f7;
            --admin-gold: #c9a84c; --plus-indigo: #4b0082;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg); color: var(--text-main); font-family: 'Goudy Old Style', serif; -webkit-font-smoothing: antialiased; overscroll-behavior-y: none; }
        html { background-color: #000; }
        body { background-color: var(--bg); min-height: 100vh; }

        header { background-color: #000; height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 60px; position: sticky; top: 0; z-index: 1000; }
        .brand-wrapper { display: inline-flex; align-items: flex-end; gap: 5px; text-decoration: none; cursor: pointer; }
        .brand { font-family: 'Cinzel', serif; font-size: 2.8rem; letter-spacing: 5px; text-transform: lowercase; color: #fff; line-height: 1; }
        .plus-sticker { display: none; color: var(--accent-purple); font-family: 'Montserrat', sans-serif; font-size: 0.5rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; line-height: 1; margin-bottom: 10px; }
        nav { display: flex; gap: 60px; }
        nav a { text-decoration: none; color: #fff; font-size: 1.5rem; opacity: 0.45; transition: 0.4s; cursor: pointer; }
        nav a:hover { opacity: 1; }
        .header-right { justify-self: end; display: flex; align-items: center; gap: 18px; }
        .header-avatar-wrap { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .header-avatar { 
            width: 28px; height: 28px; border-radius: 50%;
            background: #1a1a1a; border: 1px solid #2a2a2a;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.6rem; font-weight: 600; color: #fff;
            overflow: hidden; font-family: 'Cinzel', serif;
            transition: border-color 0.3s;
        }
        .header-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .header-avatar.plus-border { border-color: var(--accent-purple); }
        .header-avatar.gold-border { border-color: var(--admin-gold); }
        .header-username { font-family: 'Montserrat'; font-size: 0.65rem; letter-spacing: 2px; color: #fff; opacity: 0.5; text-transform: uppercase; }
        .auth-btn { 
            font-family: 'Montserrat'; font-size: 0.6rem; letter-spacing: 2px; 
            text-transform: uppercase; color: #fff; opacity: 0.3; 
            background: none; border: none; cursor: pointer; transition: 0.2s; padding: 0; 
        }
        .auth-btn:hover { opacity: 1; }

        .product-container { max-width: 1400px; margin: 80px auto; padding: 0 60px; display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
        .product-image { width: 100%; aspect-ratio: 3 / 4; background-color: var(--light-gray); border: 1px solid #efefef; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
        .product-image span { font-family: 'Cinzel', serif; font-size: 22rem; color: #f6f6f6; position: absolute; bottom: -50px; right: -30px; pointer-events: none; }

        .auction-timer-overlay { display: none; }

        .product-details { display: flex; flex-direction: column; }
        .lot-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .lot-tag { font-family: 'Montserrat', sans-serif; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 3px; color: #000; font-weight: 600; }
        .product-tools { display: flex; gap: 25px; }
        .tool-btn { background: none; border: none; cursor: pointer; display: flex; align-items: center; }
        .icon-svg { width: 22px; height: 22px; fill: none; stroke: #000; stroke-width: 1.5px; transition: 0.3s; }
        .tool-btn.active .icon-svg { fill: #000; }

        /* Обёртка заголовка с бейджем справа */
        .title-row {
            display: flex;
            align-items: baseline;
            gap: 18px;
            flex-wrap: wrap;
            margin-bottom: 25px;
        }

        /* Фиолетовый бейдж аукциона — справа от названия */
        .auction-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--auction-purple);
            color: #fff;
            padding: 6px 16px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 600;
            white-space: nowrap;
            flex-shrink: 0;
            /* чуть приподнимаем чтобы сидел по центру относительно baseline заголовка */
            position: relative;
            top: -6px;
        }
        .auction-badge.ended {
            background: #666;
        }

        .product-title { font-size: 3.5rem; margin: 0; text-transform: lowercase; line-height: 1.1; font-weight: normal; }
        .product-desc { font-family: 'Montserrat', sans-serif; font-size: 1.05rem; line-height: 1.8; color: #333; font-weight: 300; margin-bottom: 40px; }
        .action-box { background-color: #000; color: #fff; width: 100%; height: 90px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; cursor: pointer; }
        .price-text, .buy-text { font-family: 'Montserrat', sans-serif; font-size: 1.1rem; position: absolute; transition: 0.5s; font-weight: 300; }
        .buy-text { transform: translateY(40px); opacity: 0; font-weight: 600; text-transform: uppercase; letter-spacing: 5px; }
        .action-box:hover .price-text { transform: translateY(-40px); opacity: 0; }
        .action-box:hover .buy-text { transform: translateY(0); opacity: 1; }
        .action-box.ended { background: #666; cursor: not-allowed; }
        .action-box.ended .buy-text { content: "AUCTION ENDED"; }
        .category-wrap { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 40px; border-top: 1px solid #eee; padding-top: 30px; }
        .cat-tag { font-family: 'Montserrat', sans-serif; font-size: 0.6rem; text-transform: uppercase; padding: 6px 15px; border: 1px solid #eee; color: #999; text-decoration: none; transition: 0.3s; }
        .cat-tag:hover { border-color: #000; color: #000; }

        .seller-card { margin-top: 30px; display: flex; align-items: center; justify-content: space-between; }
        .seller-link { display: flex; align-items: center; gap: 16px; text-decoration: none; color: inherit; flex: 1; }
        .seller-link:hover .seller-name { text-decoration: underline; text-underline-offset: 3px; }
        .seller-avatar-circle { width: 50px; height: 50px; border-radius: 50%; background: #000; border: 2px solid #000; display: flex; align-items: center; justify-content: center; font-family: 'Cinzel', serif; font-size: 1.1rem; color: #fff; overflow: hidden; flex-shrink: 0; transition: border-color 0.3s; }
        .seller-avatar-circle img { width: 100%; height: 100%; object-fit: cover; }
        .seller-avatar-circle.plus-border { border-color: var(--accent-purple); }
        .seller-avatar-circle.gold-border { border-color: var(--admin-gold); }
        .seller-meta-wrap { display: flex; flex-direction: column; gap: 5px; }
        .seller-name-line { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .seller-name { font-family: 'Montserrat'; font-weight: 600; font-size: 0.9rem; text-transform: lowercase; color: #000; }
        .seller-badge {
            font-family: 'Montserrat'; font-size: 0.42rem; font-weight: 600;
            letter-spacing: 2px; text-transform: uppercase;
            padding: 2px 7px; line-height: 1.7; border-radius: 2px; flex-shrink: 0;
        }
        .seller-badge-plus { color: var(--accent-purple); border: 1px solid var(--accent-purple); }
        .seller-badge-admin { color: var(--admin-gold); border: 1px solid var(--admin-gold); }
        .seller-meta { font-family: 'Montserrat'; font-size: 0.7rem; color: #999; }
        .follow-btn { background: none; border: 1px solid #000; padding: 8px 20px; font-family: 'Montserrat'; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: 0.3s; flex-shrink: 0; }
        .follow-btn.following { background: #000; color: #fff; }

        .reviews-section { margin-top: 28px; padding-top: 28px; border-top: 1px solid #eee; }
        .reviews-label { font-family: 'Montserrat'; font-size: 0.5rem; text-transform: uppercase; letter-spacing: 4px; opacity: 0.35; margin-bottom: 16px; display: block; }
        .review-item { display: flex; gap: 14px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid #f5f5f5; }
        .review-item:last-child { border-bottom: none; }
        .review-avatar { width: 32px; height: 32px; border-radius: 50%; background: #f0f0f0; border: 1px solid #eee; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-family: 'Cinzel'; font-size: 0.75rem; color: #999; }
        .review-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .review-body { flex: 1; }
        .review-top { display: flex; align-items: center; gap: 10px; margin-bottom: 5px; flex-wrap: wrap; }
        .review-buyer { font-family: 'Montserrat'; font-size: 0.65rem; font-weight: 600; color: #000; }
        .review-stars { font-size: 0.65rem; color: #000; letter-spacing: 1px; }
        .review-text { font-family: 'Montserrat'; font-size: 0.68rem; line-height: 1.7; color: #666; font-weight: 300; }
        .no-reviews { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.25; padding: 16px 0; }

        .admin-controls {
            display: none;
            margin-top: 20px;
            padding-top: 18px;
            border-top: 1px solid #f0f0f0;
            gap: 8px;
            flex-wrap: wrap;
        }
        .admin-controls.visible { display: flex; }
        .admin-ctrl-btn {
            font-family: 'Montserrat'; font-size: 0.5rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: 2px;
            padding: 8px 18px; border: 1px solid;
            cursor: pointer; transition: 0.2s; background: transparent;
        }
        .admin-ctrl-btn.edit { border-color: #ccc; color: #888; }
        .admin-ctrl-btn.edit:hover { border-color: #000; color: #000; }
        .admin-ctrl-btn.remove { border-color: #e0c0c0; color: #c0392b; opacity: 0.6; }
        .admin-ctrl-btn.remove:hover { border-color: #c0392b; opacity: 1; }

        .modal-backdrop {
            position: fixed; inset: 0; background: rgba(0,0,0,0.55);
            z-index: 4000; display: none; align-items: center; justify-content: center;
        }
        .modal-backdrop.open { display: flex; }
        .modal {
            background: #fff; width: 440px; max-width: 95vw;
            padding: 44px 40px 36px; position: relative;
        }
        .modal-close { position: absolute; top: 16px; right: 20px; font-size: 1rem; cursor: pointer; opacity: 0.3; background: none; border: none; font-family: 'Montserrat'; transition: 0.2s; }
        .modal-close:hover { opacity: 1; }
        .modal-title { font-family: 'Cinzel'; font-size: 0.9rem; letter-spacing: 5px; text-transform: uppercase; margin-bottom: 28px; }
        .modal-field-wrap { border-bottom: 1px solid #ddd; padding-bottom: 12px; margin-bottom: 24px; transition: border-color 0.25s; }
        .modal-field-wrap:focus-within { border-bottom-color: #000; }
        .modal-input {
            width: 100%; border: none; background: transparent;
            font-family: 'Montserrat'; font-size: 1rem; font-weight: 300;
            outline: none; color: #000; padding: 4px 0;
        }
        .modal-input::placeholder { color: #ddd; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; }
        .modal-btn { padding: 9px 24px; font-family: 'Montserrat'; font-size: 0.6rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; cursor: pointer; transition: 0.2s; border: 1px solid #000; background: #fff; }
        .modal-btn:hover { background: #000; color: #fff; }
        .modal-btn.primary { background: #000; color: #fff; }
        .modal-btn.primary:hover { background: #333; }

        .removed-overlay { display: none; position: fixed; inset: 0; z-index: 5000; background: #fff; align-items: center; justify-content: center; flex-direction: column; gap: 20px; }
        .removed-overlay.show { display: flex; }
        .removed-icon { font-family: 'Cinzel'; font-size: 3rem; opacity: 0.1; }
        .removed-title { font-family: 'Cinzel'; font-size: 2rem; letter-spacing: 6px; text-transform: uppercase; }
        .removed-sub { font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 4px; opacity: 0.3; }
        .removed-back { display: inline-block; margin-top: 20px; padding: 14px 36px; border: 1px solid #000; font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 3px; text-decoration: none; color: #000; transition: 0.3s; }
        .removed-back:hover { background: #000; color: #fff; }

        .recommendations { max-width: 1400px; margin: 0 auto 100px; padding: 80px 60px 0; border-top: 1px solid #eee; }
        .rec-title { font-family: 'Cinzel', serif; font-size: 1.8rem; margin-bottom: 50px; text-align: center; letter-spacing: 3px; }
        .rec-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
        .rec-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; position: relative; }
        .rec-img { width: 100%; aspect-ratio: 3/4; background: var(--light-gray); border: 1px solid #eee; display: flex; align-items: center; justify-content: center; position: relative; margin-bottom: 20px; overflow: hidden; }
        .rec-img::before { content: ""; position: absolute; left: 0; bottom: 0; width: 2px; height: 100%; background-color: #000; transform: scaleY(0); transform-origin: bottom; transition: transform 0.6s cubic-bezier(0.215, 0.61, 0.355, 1); z-index: 5; }
        .rec-card:hover .rec-img::before { transform: scaleY(1); }
        .rec-img span { font-family: 'Cinzel'; font-size: 8rem; color: #f0f0f0; position: absolute; bottom: -20px; right: -10px; }
        .rec-info { border-top: 1px solid #000; padding-top: 15px; }

        .footer-main { border-top: 1px solid #000; padding: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; background: #fff; margin-top: 100px; }
        .footer-brand { font-family: 'Cinzel', serif; font-size: 1.3rem; letter-spacing: 5px; text-transform: lowercase; }
        .footer-copy { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: center; }
        .footer-tagline { font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: right; }

        .toast { position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%) translateY(20px); background: #000; color: #fff; font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; padding: 14px 28px; opacity: 0; transition: opacity 0.3s, transform 0.3s; pointer-events: none; z-index: 9000; }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    </style>
</head>
<body>
    <header>
        <div class="brand-wrapper" onclick="window.location.href='/'">
            <span class="brand">noir</span>
            <span id="headerPlus" class="plus-sticker">plus</span>
        </div>
        <nav>
            <a onclick="window.location.href='/'">Catalog</a>
            <a onclick="requireAuth('/Auction')">Auction</a>
            <a onclick="requireAuth('/Archive')">Archive</a>
            <a onclick="requireAuth('/Upload')">Upload</a>
        </nav>
        <div class="header-right">
            <div class="header-avatar-wrap" onclick="requireAuth('/Account')">
                <div class="header-avatar" id="headerAvatar"></div>
                <span class="header-username" id="headerUsername"></span>
            </div>
            <button class="auth-btn" id="authBtn" onclick="handleAuth()">sign in</button>
        </div>
    </header>

    <main class="product-container" id="productContainer">
        <div class="product-image">
            @if(item.IsAuction) { 
                <div class="auction-timer-overlay" id="auctionTimerOverlay">
                    <span id="timerText">Auction • 05:00</span>
                </div> 
            }
            <span>@(item.Id)</span>
        </div>

        <div class="product-details">
            <div class="lot-header">
                <div style="display:flex; flex-direction:column; gap:14px;">
                    <span class="lot-tag">Archive Ref: 00@(item.Id)</span>
                    @if (item.IsAuction)
                    {
                        <div class="auction-badge" id="auctionBadge">
                            <span>AUCTION</span>
                            <span id="badgeTimer">--:--:--:--</span>
                        </div>
                    }
                </div>
                <div class="product-tools">
                    <button class="tool-btn" onclick="this.classList.toggle('active')">
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                    </button>
                    <button class="tool-btn" onclick="this.classList.toggle('active')">
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    </button>
                </div>
            </div>

            <!-- Заголовок -->
            <div class="title-row">
                <h1 class="product-title" id="productTitle">@item.Title</h1>
            </div>

            <p class="product-desc">@item.Desc</p>

            @if (item.IsAuction)
            {
                <a href="/NewBid?id=@(item.Id)" class="action-box" id="actionBox" style="text-decoration: none;">
                    <div class="price-text" id="priceDisplay">VALUE: EUR @item.Price.ToString("N0")</div>
                    <div class="buy-text" id="buyText">@actionText</div>
                </a>
            }
            else
            {
                <div class="action-box" id="actionBox">
                    <div class="price-text" id="priceDisplay">VALUE: EUR @item.Price.ToString("N0")</div>
                    <div class="buy-text" id="buyText">@actionText</div>
                </div>
            }

            <div class="category-wrap">
                @foreach (var cat in item.Categories) { <a href="#" class="cat-tag">@cat</a> }
            </div>

            <div class="seller-card">
                <a href="/Seller?username=@sellerUsername" class="seller-link">
                    <div class="seller-avatar-circle @(sellerIsAdmin ? "gold-border" : (sellerIsPlus ? "plus-border" : ""))" id="sellerAvatar"></div>
                    <div class="seller-meta-wrap">
                        <div class="seller-name-line">
                            <span class="seller-name">@@@sellerUsername</span>
                            @if (sellerIsPlus) { <span class="seller-badge seller-badge-plus">plus</span> }
                            @if (sellerIsAdmin) { <span class="seller-badge seller-badge-admin">Admin</span> }
                        </div>
                        <div class="seller-meta">Rating: ★★★★★ (42 deals)</div>
                    </div>
                </a>
                <button class="follow-btn" onclick="this.classList.toggle('following'); this.innerText = this.classList.contains('following') ? 'Following' : 'Follow';">Follow</button>
            </div>

            <div class="reviews-section">
                <span class="reviews-label">Recent reviews</span>
                <div id="reviewsList"></div>
            </div>

            <div class="admin-controls" id="adminControls">
                <button class="admin-ctrl-btn edit" onclick="openEditModal()">Edit title</button>
                <button class="admin-ctrl-btn remove" onclick="confirmRemove()">Remove listing</button>
            </div>
        </div>
    </main>

    <section class="recommendations">
        <h2 class="rec-title">curated for you</h2>
        <div class="rec-grid">
            @foreach (var rec in recommendations) {
                <a href="/Product?id=@(rec.Id)" class="rec-card">
                    <div class="rec-img"><span>@(rec.Id)</span></div>
                    <div class="rec-info">
                        <h4 style="font-size: 1.4rem; font-weight: normal;">@rec.Title</h4>
                        <p style="font-family: 'Montserrat'; font-size: 0.8rem; margin-top: 5px;">EUR @rec.Price.ToString("N0")</p>
                    </div>
                </a>
            }
        </div>
    </section>

    <footer class="footer-main">
        <span class="footer-brand">noir</span>
        <span class="footer-copy">© 2026 noir private collection. all rights reserved.</span>
        <span class="footer-tagline">objects of consequence</span>
    </footer>

    <div class="modal-backdrop" id="editModal">
        <div class="modal">
            <button class="modal-close" onclick="closeEditModal()">✕</button>
            <div class="modal-title">Edit title</div>
            <div class="modal-field-wrap">
                <input type="text" class="modal-input" id="newTitleInput" placeholder="@item.Title">
            </div>
            <div class="modal-actions">
                <button class="modal-btn" onclick="closeEditModal()">Cancel</button>
                <button class="modal-btn primary" onclick="saveTitle()">Save</button>
            </div>
        </div>
    </div>

    <div class="removed-overlay" id="removedOverlay">
        <div class="removed-icon">✕</div>
        <div class="removed-title">Listing Removed</div>
        <div class="removed-sub">This item has been taken off the catalog</div>
        <a href="/" class="removed-back">Return to Catalog</a>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        var ITEM_ID = @(item.Id);
        var ITEM_ORIGINAL_TITLE = "@item.Title";
        var IS_AUCTION = @(item.IsAuction ? "true" : "false");
        var AUCTION_DURATION = @(item.IsAuction ? item.AuctionDurationMinutes : 0);
        var AUCTION_DURATION_DAYS = @(item.IsAuction ? item.AuctionDurationDays : 0);

        var SAMPLE_REVIEWS = [
            { buyer: "tornadomart1", stars: 5, text: "Exceptional quality, arrived perfectly packaged. Exactly as described.", avatarExists: false },
            { buyer: "anonymous", stars: 4, text: "Beautiful piece, very authentic. Minor delay in shipping but worth the wait.", avatarExists: false },
            { buyer: "collector_x", stars: 5, text: "Stunning acquisition. The seller's expertise is evident in every detail.", avatarExists: false }
        ];

        function getAdmins() {
            return JSON.parse(localStorage.getItem('noir_admins') || '["@@if6was7"]');
        }

        function requireAuth(url) {
            if (!sessionStorage.getItem('noir_user')) {
                window.location.href = '/Log_In';
            } else {
                window.location.href = url;
            }
        }

        function renderReviews() {
            var list = document.getElementById('reviewsList');
            var stored = JSON.parse(localStorage.getItem('noir_reviews_' + ITEM_ID) || 'null');
            var reviews = stored || SAMPLE_REVIEWS;

            if (!reviews || reviews.length === 0) {
                list.innerHTML = '<div class="no-reviews">No reviews yet</div>';
                return;
            }

            var last3 = reviews.slice(-3).reverse();
            var html = '';
            last3.forEach(function(r) {
                var stars = '';
                for (var i = 0; i < 5; i++) {
                    stars += i < r.stars ? '★' : '☆';
                }
                var initial = (r.buyer || 'A').charAt(0).toUpperCase();
                var avatarHtml = '<div class="review-avatar">' + initial + '</div>';

                html += '<div class="review-item">' +
                    avatarHtml +
                    '<div class="review-body">' +
                        '<div class="review-top">' +
                            '<span class="review-buyer">@@' + r.buyer + '</span>' +
                            '<span class="review-stars">' + stars + '</span>' +
                        '</div>' +
                        '<div class="review-text">' + r.text + '</div>' +
                    '</div>' +
                '</div>';
            });
            list.innerHTML = html;
        }

        function loadUser() {
            var userData = sessionStorage.getItem('noir_user');
            var user = userData ? JSON.parse(userData) : null;
            var isGuest = !user;

            var displayName = 'guest';
            if (!isGuest) {
                if (user.nickname && user.nickname.length > 0) displayName = user.nickname;
                else if (user.displayName && user.displayName !== user.email) displayName = user.displayName;
                else if (user.name) displayName = user.name;
                else if (user.username) displayName = user.username.replace('@@', '');
                else if (user.email) displayName = user.email.split('@@')[0];
            }

            var ha = document.getElementById('headerAvatar');
            ha.innerHTML = '';

            if (!isGuest) {
                var cleanName = (user.username || user.email || '').replace('@@', '').split('@@')[0];
                var avatarPath = '/images/avatar/' + cleanName + '.jpg';
                var img = document.createElement('img');
                img.src = avatarPath;
                img.onerror = function() {
                    ha.removeChild(img);
                    ha.style.backgroundColor = '#000';
                };
                ha.appendChild(img);
            } else {
                ha.style.backgroundColor = '#000';
            }

            document.getElementById('headerUsername').innerText = displayName;

            var authBtn = document.getElementById('authBtn');
            authBtn.innerText = isGuest ? 'sign in' : 'exit';

            if (!isGuest) {
                var admins = getAdmins();
                var isAdminMode = admins.indexOf(user.username) !== -1;
                var isSuperAdmin = (user.username === '@@if6was7');
                var isPlus = isSuperAdmin;

                if (isSuperAdmin) {
                    ha.classList.add('gold-border');
                } else if (isPlus) {
                    ha.classList.add('plus-border');
                }

                if (isPlus) {
                    document.getElementById('headerPlus').style.display = 'inline';
                }

                if (isAdminMode) {
                    var adminControls = document.getElementById('adminControls');
                    if (adminControls) adminControls.classList.add('visible');
                }
            }
        }

        function handleAuth() {
            if (!sessionStorage.getItem('noir_user')) {
                window.location.href = '/Log_In';
            } else {
                sessionStorage.removeItem('noir_user');
                location.reload();
            }
        }

        (function() {
            var removed = JSON.parse(localStorage.getItem('noir_removed_listings') || '[]');
            if (removed.indexOf(ITEM_ID) !== -1) {
                document.getElementById('removedOverlay').classList.add('show');
            }
            var titleOverrides = JSON.parse(localStorage.getItem('noir_title_overrides') || '{}');
            if (titleOverrides[ITEM_ID]) {
                document.getElementById('productTitle').innerText = titleOverrides[ITEM_ID];
            }
        })();

        (function() {
            var sellerName = "@sellerUsername";
            var sa = document.getElementById('sellerAvatar');
            var saImg = document.createElement('img');
            saImg.src = '/images/avatar/' + sellerName + '.jpg';
            saImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
            saImg.onerror = function() { sa.removeChild(saImg); sa.innerText = sellerName.charAt(0).toUpperCase(); };
            sa.appendChild(saImg);
        })();

        renderReviews();

        function openEditModal() {
            var current = document.getElementById('productTitle').innerText;
            document.getElementById('newTitleInput').value = current;
            document.getElementById('editModal').classList.add('open');
            setTimeout(function() { document.getElementById('newTitleInput').focus(); }, 80);
        }
        function closeEditModal() { document.getElementById('editModal').classList.remove('open'); }
        document.getElementById('editModal').addEventListener('click', function(e) { if (e.target === this) closeEditModal(); });

        function saveTitle() {
            var val = document.getElementById('newTitleInput').value.trim();
            if (!val) return;
            document.getElementById('productTitle').innerText = val;
            var overrides = JSON.parse(localStorage.getItem('noir_title_overrides') || '{}');
            overrides[ITEM_ID] = val;
            localStorage.setItem('noir_title_overrides', JSON.stringify(overrides));
            closeEditModal();
            showToast('Title updated');
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && document.getElementById('editModal').classList.contains('open')) saveTitle();
            if (e.key === 'Escape') closeEditModal();
        });

        function confirmRemove() {
            var removed = JSON.parse(localStorage.getItem('noir_removed_listings') || '[]');
            if (removed.indexOf(ITEM_ID) === -1) removed.push(ITEM_ID);
            localStorage.setItem('noir_removed_listings', JSON.stringify(removed));
            document.getElementById('removedOverlay').classList.add('show');
        }

        function showToast(msg) {
            var t = document.getElementById('toast');
            t.innerText = msg;
            t.classList.add('show');
            setTimeout(function() { t.classList.remove('show'); }, 2200);
        }

        // Универсальный таймер — работает для минутных и дневных аукционов
        function startAuctionTimer() {
            if (!IS_AUCTION) return;

            var isLong = AUCTION_DURATION_DAYS > 0;

            // --- эндтайм ---
            var endTime;
            if (isLong) {
                var storedEnd = localStorage.getItem('auction_end_' + ITEM_ID);
                if (storedEnd) {
                    endTime = parseInt(storedEnd);
                } else {
                    endTime = Date.now() + (AUCTION_DURATION_DAYS * 24 * 60 * 60 * 1000);
                    localStorage.setItem('auction_end_' + ITEM_ID, endTime);
                }
            } else {
                var storedEnd = sessionStorage.getItem('auction_end_' + ITEM_ID);
                if (storedEnd) {
                    endTime = parseInt(storedEnd);
                } else {
                    endTime = Date.now() + (AUCTION_DURATION * 60 * 1000);
                    sessionStorage.setItem('auction_end_' + ITEM_ID, endTime);
                }
            }

            // --- элементы ---
            var badgeTimer  = document.getElementById('badgeTimer');
            var badge       = document.getElementById('auctionBadge');
            var timerEl     = document.getElementById('timerText');
            var overlayEl   = document.getElementById('auctionTimerOverlay');
            var actionBox   = document.getElementById('actionBox');
            var buyText     = document.getElementById('buyText');

            function onEnded() {
                // бейдж
                if (badgeTimer) badgeTimer.innerText = 'ENDED';
                if (badge) badge.classList.add('ended');

                // оверлей на картинке
                if (timerEl) timerEl.innerText = 'Auction Ended';
                if (overlayEl) overlayEl.classList.add('ended');

                // кнопка
                if (actionBox) {
                    actionBox.classList.add('ended');
                    actionBox.style.pointerEvents = 'none';
                }
                if (buyText) buyText.innerText = 'AUCTION ENDED';

                // fade-out через 3 сек
                setTimeout(function() {
                    var container = document.getElementById('productContainer');
                    if (!container) return;
                    container.style.transition = 'opacity 1s, transform 1s';
                    container.style.opacity = '0';
                    container.style.transform = 'scale(0.95)';
                    setTimeout(function() {
                        container.style.display = 'none';
                        var msg = document.createElement('div');
                        msg.style.cssText = 'text-align:center;padding:200px 20px;font-family:Cinzel;font-size:2rem;letter-spacing:6px;';
                        msg.innerHTML = 'This lot has been sold<br><a href="/" style="font-family:Montserrat;font-size:0.6rem;letter-spacing:3px;text-transform:uppercase;color:#999;text-decoration:none;margin-top:20px;display:inline-block;">← Return to catalog</a>';
                        document.querySelector('main').appendChild(msg);
                    }, 1000);
                }, 3000);
            }

            function formatBadge(remaining) {
                var d = Math.floor(remaining / (24*60*60*1000));
                var h = Math.floor((remaining % (24*60*60*1000)) / (60*60*1000));
                var m = Math.floor((remaining % (60*60*1000)) / (60*1000));
                var s = Math.floor((remaining % (60*1000)) / 1000);
                return (d<10?'0':'')+d+':'+(h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(s<10?'0':'')+s;
            }

            function tick() {
                var remaining = endTime - Date.now();

                if (remaining <= 0) {
                    onEnded();
                    return;
                }

                var formatted = formatBadge(remaining);

                // обновляем бейдж справа от заголовка
                if (badgeTimer) badgeTimer.innerText = formatted;

                // обновляем оверлей на картинке (только для минутных)
                if (!isLong && timerEl) {
                    var m = Math.floor(remaining / 60000);
                    var s = Math.floor((remaining % 60000) / 1000);
                    timerEl.innerText = 'Auction • ' + (m<10?'0':'')+m+':'+(s<10?'0':'')+s;
                } else if (isLong && timerEl) {
                    timerEl.innerText = 'Auction • ' + formatBadge(remaining);
                }
            }

            tick();
            setInterval(tick, 1000);
        }

        loadUser();
        startAuctionTimer();
    </script>
</body>
</html>
