@page
@model noir.Pages.NewBidModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>noir — bid</title>
    <link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Cinzel:wght@700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #ffffff;
            --text: #000;
            --gray: #efefef;
            --accent-gray: #888;
            --accent-purple: #a855f7;
            --admin-gold: #c9a84c;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { background-color: #000; }
        body { background-color: var(--bg); color: var(--text); font-family: 'Goudy Old Style', serif; -webkit-font-smoothing: antialiased; min-height: 100vh; overscroll-behavior-y: none; }

        /* ── Header ── */
        header { background: #000; height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 60px; position: sticky; top: 0; z-index: 1000; }
        .brand-wrapper { display: inline-flex; align-items: flex-end; gap: 5px; text-decoration: none; cursor: pointer; }
        .brand { font-family: 'Cinzel', serif; font-size: 2.8rem; letter-spacing: 5px; text-transform: lowercase; color: #fff; line-height: 1; }
        .plus-sticker { display: none; color: var(--accent-purple); font-family: 'Montserrat', sans-serif; font-size: 0.5rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; line-height: 1; margin-bottom: 10px; }
        nav { display: flex; gap: 60px; }
        nav a { text-decoration: none; color: #fff; font-size: 1.5rem; opacity: 0.45; transition: 0.3s; cursor: pointer; }
        nav a:hover, nav a.active { opacity: 1; }
        .header-right { justify-self: end; display: flex; align-items: center; gap: 18px; }
        .header-avatar-wrap { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .header-avatar {
            width: 28px; height: 28px; border-radius: 50%;
            background: #000; border: 1px solid #2a2a2a;
            display: flex; align-items: center; justify-content: center;
            overflow: hidden; transition: border-color 0.3s;
        }
        .header-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .header-avatar.plus-border { border-color: var(--accent-purple); }
        .header-avatar.gold-border { border-color: var(--admin-gold); }
        .header-username { font-family: 'Montserrat'; font-size: 0.65rem; letter-spacing: 2px; color: #fff; opacity: 0.5; text-transform: uppercase; }
        .auth-btn { 
            font-family: 'Montserrat'; font-size: 0.6rem; letter-spacing: 2px; 
            text-transform: uppercase; color: #fff; opacity: 0.3; 
            background: none; border: none; cursor: pointer; transition: 0.2s; padding: 0; 
        }
        .auth-btn:hover { opacity: 1; }

        /* ── Content ── */
        .container { max-width: 900px; margin: 80px auto; padding: 0 40px; }

        .bid-header { border-left: 2px solid #000; padding-left: 30px; margin-bottom: 60px; }
        .bid-header-label { font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 4px; opacity: 0.4; margin-bottom: 10px; }
        .bid-header h1 { font-family: 'Cinzel'; font-size: 2.8rem; letter-spacing: 4px; text-transform: lowercase; font-weight: normal; }

        .lot-summary {
            display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
            border: 1px solid #efefef; padding: 25px 30px; margin-bottom: 16px;
        }
        .lot-summary-col { text-align: center; }
        .lot-summary-label { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.4; margin-bottom: 8px; }
        .lot-summary-value { font-family: 'Montserrat'; font-size: 1.4rem; font-weight: 600; }

        .item-desc {
            font-family: 'Montserrat'; font-size: 0.75rem; line-height: 1.8;
            color: #888; letter-spacing: 0.5px; font-weight: 300;
            padding: 0 2px; margin-bottom: 50px;
        }

        .section-label { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; color: var(--accent-gray); margin-bottom: 20px; display: block; }

        .bid-input-wrap { margin-bottom: 50px; }
        .noir-input {
            width: 100%; border: none; border-bottom: 1px solid var(--gray); background: transparent;
            padding: 12px 0; font-family: 'Montserrat', sans-serif; font-size: 1.6rem;
            outline: none; transition: 0.3s; font-weight: 300; color: #000;
            letter-spacing: 1px;
        }
        .noir-input:focus { border-bottom-color: #000; }
        .noir-input::placeholder { color: #ccc; font-size: 1rem; }

        .payment-methods { display: flex; gap: 12px; margin-bottom: 50px; flex-wrap: wrap; }
        .pay-option input { display: none; }
        .pay-label {
            display: flex; align-items: center; justify-content: center;
            width: 110px; height: 76px; border: 1px solid var(--gray);
            transition: border-color 0.3s; cursor: pointer;
        }
        .pay-label:hover { border-color: #aaa; }
        .pay-option input:checked + .pay-label { border-color: #000; outline: 1px solid #000; }
        .pay-img { width: 68px; height: 42px; object-fit: contain; image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges; }
        .balance-label { font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 3px; font-weight: 500; opacity: 0.5; }

        .custom-pay-input { display: none; margin-bottom: 50px; }
        .custom-pay-input.visible { display: block; }
        .custom-pay-input .noir-input { font-size: 1.1rem; }

        .order-summary { border: 1px solid #efefef; padding: 30px; margin-bottom: 40px; }
        .order-row { display: flex; justify-content: space-between; align-items: center; font-family: 'Montserrat'; font-size: 0.75rem; padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
        .order-row:last-child { border-bottom: none; padding-top: 16px; }
        .order-row-label { opacity: 0.45; text-transform: uppercase; letter-spacing: 2px; }
        .order-row-value { font-weight: 600; }
        .order-row.total .order-row-label { opacity: 1; font-weight: 600; font-size: 0.85rem; }
        .order-row.total .order-row-value { font-size: 1rem; }

        .confirm-btn {
            width: 100%; height: 80px; background: #000; color: #fff; border: none;
            font-family: 'Montserrat'; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 6px;
            cursor: pointer; transition: background 0.4s; margin-bottom: 20px;
        }
        .confirm-btn:hover { background: #222; }
        .confirm-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .confirm-note { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 2px; opacity: 0.3; text-align: center; }

        /* Success screen */
        .success-screen { display: none; text-align: center; padding: 120px 40px; }
        .success-screen.show { display: block; }
        .success-check { width: 60px; height: 60px; background: rgba(34,197,94,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #22c55e; margin: 0 auto 1.2rem; }
        .success-title { font-family: 'Cinzel'; font-size: 2rem; letter-spacing: 6px; text-transform: uppercase; margin-bottom: 12px; }
        .success-sub { font-family: 'Montserrat'; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; margin-bottom: 2rem; }
        .success-back { display: inline-block; padding: 14px 36px; border: 1px solid #000; font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 3px; text-decoration: none; color: #000; transition: 0.3s; cursor: pointer; background: transparent; }
        .success-back:hover { background: #000; color: #fff; }

        /* Error toast */
        .error-toast {
            display: none; background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.3);
            padding: 16px 24px; margin-bottom: 30px; text-align: center;
            font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase;
            letter-spacing: 2px; color: #ef4444;
        }
        .error-toast.show { display: block; }

        /* Balance info */
        .balance-info {
            display: none; font-family: 'Montserrat'; font-size: 0.55rem;
            text-transform: uppercase; letter-spacing: 2px; opacity: 0.4;
            margin-bottom: 20px; padding: 10px 0; border-bottom: 1px solid #eee;
        }
        .balance-info.show { display: block; }

        .footer { margin-top: 120px; border-top: 1px solid #000; padding: 60px 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
        .footer-brand { font-family: 'Cinzel'; font-size: 1.2rem; letter-spacing: 5px; text-transform: lowercase; }
        .footer-copy { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: center; }
        .footer-tagline { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: right; }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()

    <header>
        <div class="brand-wrapper" onclick="window.location.href='/'">
            <span class="brand">noir</span>
            @if (Model.CurrentUser?.HasPlus == true || Model.CurrentUser?.Role == "admin" || Model.CurrentUser?.Role == "superadmin")
            {
                <span id="headerPlus" class="plus-sticker" style="display:inline">plus</span>
            }
            else
            {
                <span id="headerPlus" class="plus-sticker">plus</span>
            }
        </div>
        <nav>
            <a onclick="window.location.href='/'">Catalog</a>
            <a onclick="requireAuth('/Auction')">Auction</a>
            <a onclick="requireAuth('/Archive')">Archive</a>
            <a onclick="requireAuth('/Upload')">Upload</a>
        </nav>
        <div class="header-right">
            @if (Model.CurrentUser != null)
            {
                <div class="header-avatar-wrap" onclick="location.href='/Account'">
                    <div class="header-avatar @(Model.CurrentUser.Role == "superadmin" ? "gold-border" : Model.CurrentUser.HasPlus ? "plus-border" : "")" id="headerAvatar">
                        @if (!string.IsNullOrEmpty(Model.CurrentUser.AvatarUrl))
                        {
                            <img src="@Model.CurrentUser.AvatarUrl" alt="" onerror="this.style.display='none'" />
                        }
                        else if (Model.CurrentUser.Username == "if6was7")
                        {
                            <span style="font-size:0.7rem; font-weight:bold;">@Model.CurrentUser.Username.Substring(0,1).ToUpper()</span>
                        }
                        else
                        {
                            <img src="/images/avatar/@(Model.CurrentUser.Username).jpg" onerror="tryNextExt(this, '@Model.CurrentUser.Username')" alt="" />
                        }
                    </div>
                    <span class="header-username" id="headerUsername">@(Model.CurrentUser.Username == "if6was7" ? Model.CurrentUser.Username : (string.IsNullOrEmpty(Model.CurrentUser.Nickname) ? Model.CurrentUser.Username : Model.CurrentUser.Nickname))</span>
                </div>
                <button class="auth-btn" id="authBtn" onclick="logout()">exit</button>
            }
            else
            {
                <div class="header-avatar-wrap" onclick="location.href='/Log_In'">
                    <div class="header-avatar" id="headerAvatar" data-role="guest"></div>
                    <span class="header-username" id="headerUsername">guest</span>
                </div>
                <button class="auth-btn" id="authBtn" onclick="location.href='/Log_In'">sign in</button>
            }
        </div>
    </header>

    <main class="container">

        <div id="bidForm">
            <div class="bid-header">
                <div class="bid-header-label">Auction Lot — @(Model.Item?.ArchiveRef ?? "000")</div>
                <h1>@(Model.Item?.Title ?? "Unknown Item")</h1>
            </div>

            <div class="lot-summary">
                <div class="lot-summary-col">
                    <div class="lot-summary-label">Current Price</div>
                    <div class="lot-summary-value">EUR @(Model.Item?.AuctionLot?.CurrentPrice.ToString("N0") ?? "0")</div>
                </div>
                <div class="lot-summary-col">
                    <div class="lot-summary-label">Minimum Bid</div>
                    <div class="lot-summary-value">EUR @(Model.MinBid.ToString("N0"))</div>
                </div>
            </div>
            <p class="item-desc">@(Model.Item?.Description ?? "")</p>

            <div class="balance-info @(Model.CurrentUser != null ? "show" : "")" id="balanceInfo">
                Your balance: <strong>€@(Model.CurrentUser?.Balance.ToString("N2") ?? "0.00")</strong>
            </div>

            <div class="error-toast" id="errorToast"></div>

            <div class="bid-input-wrap">
                <span class="section-label">Your Bid</span>
                <input type="number" step="0.01" min="@(Model.MinBid.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="noir-input" id="bidAmount" placeholder="Enter bid amount (min €@(Model.MinBid.ToString("N2")))" oninput="updateSummary()">
            </div>

            <span class="section-label">Payment method</span>
            <div class="payment-methods">
                <label class="pay-option">
                    <input type="radio" name="payment" value="paypal" checked onchange="onPaymentChange(this.value)">
                    <span class="pay-label"><img class="pay-img" src="/images/paypal.jpg" alt="PayPal"></span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment" value="visa" onchange="onPaymentChange(this.value)">
                    <span class="pay-label"><img class="pay-img" src="/images/visa.jpg" alt="Visa"></span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment" value="mastercard" onchange="onPaymentChange(this.value)">
                    <span class="pay-label"><img class="pay-img" src="/images/mastercard.jpg" alt="Mastercard"></span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment" value="mir" onchange="onPaymentChange(this.value)">
                    <span class="pay-label"><img class="pay-img" src="/images/mir.jpg" alt="Mir"></span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment" value="applepay" onchange="onPaymentChange(this.value)">
                    <span class="pay-label"><img class="pay-img" src="/images/applepay.jpg" alt="Apple Pay"></span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment" value="balance" onchange="onPaymentChange(this.value)">
                    <span class="pay-label"><span class="balance-label">Balance</span></span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment" value="custom" onchange="showCustom()">
                    <span class="pay-label"><span style="font-size: 2rem; opacity: 0.25; line-height: 1;">＋</span></span>
                </label>
            </div>

            <div class="custom-pay-input" id="customPayInput">
                <span class="section-label">Your payment method</span>
                <input type="text" class="noir-input" placeholder="Describe your payment method...">
            </div>

            <div class="order-summary">
                <div class="order-row">
                    <span class="order-row-label">Your Bid</span>
                    <span class="order-row-value" id="summaryBid">EUR 0</span>
                </div>
                <div class="order-row">
                    <span class="order-row-label">Handling & Insurance</span>
                    <span class="order-row-value">EUR @(Model.HandlingFee.ToString("N0"))</span>
                </div>
                <div class="order-row">
                    <span class="order-row-label">Noir Commission (3%)</span>
                    <span class="order-row-value">EUR @(Model.Commission.ToString("N0"))</span>
                </div>
                <div class="order-row total">
                    <span class="order-row-label">Total if winning</span>
                    <span class="order-row-value" id="summaryTotal">EUR @(Model.TotalPrice.ToString("N0"))</span>
                </div>
            </div>

            <button type="button" class="confirm-btn" id="confirmBtn" onclick="placeBid()">Place Bid</button>
            <div class="confirm-note">By placing a bid you agree to our auction terms. All bids are binding.</div>
        </div>

        <div class="success-screen" id="successScreen">
            <div class="success-check">✓</div>
            <div class="success-title">Bid Placed</div>
            <div class="success-sub" id="successSub">Your bid has been recorded</div>
            <button class="success-back" onclick="window.location.href='/Auction'">Return to auction</button>
        </div>

        <footer class="footer" id="mainFooter">
            <span class="footer-brand">noir</span>
            <span class="footer-copy">© 2026 noir private collection. all rights reserved.</span>
            <span class="footer-tagline">objects of consequence</span>
        </footer>
    </main>

    <script>
        var ITEM_ID = @(Model.Item?.Id ?? 0);
        var ITEM_TITLE = "@(Model.Item?.Title ?? "")";
        var MIN_BID = @(Model.MinBid.ToString(System.Globalization.CultureInfo.InvariantCulture));
        var CURRENT_PRICE = @(Model.Item?.AuctionLot?.CurrentPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0");
        var USER_BALANCE = @(Model.CurrentUser?.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0");
        var HANDLING_FEE = @(Model.HandlingFee.ToString(System.Globalization.CultureInfo.InvariantCulture));
        var COMMISSION = @(Model.Commission.ToString(System.Globalization.CultureInfo.InvariantCulture));

        function logout() {
            fetch('/api/Auth/logout', { method: 'POST' })
                .then(function() {
                    sessionStorage.removeItem('noir_user');
                    window.location.href = '/';
                })
                .catch(function() {
                    sessionStorage.removeItem('noir_user');
                    window.location.href = '/';
                });
        }

        function requireAuth(url) {
            if (!sessionStorage.getItem('noir_user')) {
                window.location.href = '/Log_In';
            } else {
                window.location.href = url;
            }
        }

        function tryNextExt(img, username) {
            var extensions = ['.jpg', '.gif', '.png', '.jpeg', '.webp'];
            var currentSrc = img.src;
            var currentExt = currentSrc.substring(currentSrc.lastIndexOf('.'));
            var currentIdx = extensions.indexOf(currentExt);
            var nextIdx = currentIdx + 1;
            if (nextIdx < extensions.length) {
                img.src = '/images/avatar/' + username + extensions[nextIdx];
            } else {
                img.style.display = 'none';
                var parent = img.parentElement;
                parent.innerHTML = '<span style="font-size:0.7rem; font-weight:bold;">' + username.substring(0,1).toUpperCase() + '</span>';
            }
        }

        function showCustom() {
            document.getElementById('customPayInput').classList.add('visible');
        }
        function hideCustom() {
            document.getElementById('customPayInput').classList.remove('visible');
        }

        function onPaymentChange(method) {
            hideCustom();
            hideError();
        }

        function showError(msg) {
            var el = document.getElementById('errorToast');
            el.innerText = msg;
            el.classList.add('show');
        }
        function hideError() {
            document.getElementById('errorToast').classList.remove('show');
        }

        function updateSummary() {
            var val = parseFloat(document.getElementById('bidAmount').value) || 0;
            var total = val + HANDLING_FEE + COMMISSION;
            document.getElementById('summaryBid').innerText = 'EUR ' + val.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 2});
            document.getElementById('summaryTotal').innerText = 'EUR ' + total.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 2});
        }

        function placeBid() {
            var bidInput = document.getElementById('bidAmount');
            var bidAmount = parseFloat(bidInput.value);

            if (isNaN(bidAmount) || bidAmount < MIN_BID) {
                showError('Minimum bid is €' + MIN_BID.toFixed(2));
                return;
            }

            var selectedPayment = document.querySelector('input[name="payment"]:checked').value;
            console.log('[DEBUG] Bid:', bidAmount, 'Payment:', selectedPayment);
            hideError();

            if (selectedPayment === 'balance') {
                if (USER_BALANCE < bidAmount) {
                    showError('Insufficient balance. You have €' + USER_BALANCE.toFixed(2) + ', need €' + bidAmount.toFixed(2));
                    return;
                }

                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('Source', 'auction');
                formData.append('LotId', ITEM_ID);
                formData.append('Amount', bidAmount);
                formData.append('UseBalance', 'true');
                formData.append('ItemTitle', ITEM_TITLE);

                console.log('[DEBUG] POSTing to /Payment for auction bid');

                fetch('/Payment', {
                    method: 'POST',
                    body: formData
                })
                .then(function(r) {
                    console.log('[DEBUG] Response status:', r.status);
                    if (!r.ok) throw new Error('Server error: ' + r.status);
                    return r.json();
                })
                .then(function(data) {
                    console.log('[DEBUG] Response data:', data);
                    if (data.success) {
                        document.getElementById('bidForm').style.display = 'none';
                        document.getElementById('mainFooter').style.display = 'none';
                        document.getElementById('successScreen').classList.add('show');
                        document.getElementById('successSub').innerText = 'You bid €' + bidAmount.toFixed(2) + ' on ' + ITEM_TITLE;
                    } else {
                        showError(data.error || 'Bid failed');
                    }
                })
                .catch(function(e) {
                    console.error('[DEBUG] Fetch error:', e);
                    showError('Error: ' + e.message);
                });
                return;
            }

            var redirectUrl = '/Payment?source=auction&method=' + encodeURIComponent(selectedPayment) 
                + '&amount=' + bidAmount
                + '&lotId=' + ITEM_ID
                + '&ItemTitle=' + encodeURIComponent(ITEM_TITLE);
            
            console.log('[DEBUG] Redirecting to:', redirectUrl);
            window.location.href = redirectUrl;
        }

        @if (Model.CurrentUser != null)
        {
            <text>
            var serverUser = {
                id: @Model.CurrentUser.Id,
                username: '@Model.CurrentUser.Username',
                displayName: '@(Model.CurrentUser.Username == "if6was7" ? Model.CurrentUser.Username : (string.IsNullOrEmpty(Model.CurrentUser.Nickname) ? Model.CurrentUser.Username : Model.CurrentUser.Nickname))',
                nickname: '@(Model.CurrentUser.Nickname ?? "")',
                email: '@Model.CurrentUser.Email',
                role: '@Model.CurrentUser.Role',
                hasPlus: @(Model.CurrentUser.HasPlus ? "true" : "false"),
                balance: @(Model.CurrentUser.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                avatarUrl: '@(Model.CurrentUser.AvatarUrl ?? "")'
            };
            sessionStorage.setItem('noir_user', JSON.stringify(serverUser));
            </text>
        }
    </script>
</body>
</html>