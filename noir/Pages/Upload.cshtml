@page
@model noir.Pages.UploadModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>noir — upload</title>
    <link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Cinzel:wght@700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root { 
            --bg: #ffffff; --text: #000; --gray: #efefef;
            --purple: #4b0082; --green: #2d5a27; --accent-gray: #888;
            --accent-purple: #a855f7; --admin-gold: #c9a84c;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg); color: var(--text); font-family: 'Goudy Old Style', serif; -webkit-font-smoothing: antialiased; }
        header { background: #000; height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 60px; position: sticky; top: 0; z-index: 1000; }
        .brand-wrapper { display: inline-flex; align-items: flex-end; gap: 5px; text-decoration: none; cursor: pointer; }
        .brand { font-family: 'Cinzel', serif; font-size: 2.8rem; color: #fff; letter-spacing: 5px; line-height: 1; }
        .plus-sticker { display: none; color: var(--accent-purple); font-family: 'Montserrat', sans-serif; font-size: 0.5rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; line-height: 1; margin-bottom: 10px; }
        nav { display: flex; gap: 60px; }
        nav a { text-decoration: none; color: #fff; font-size: 1.5rem; opacity: 0.45; transition: 0.3s; cursor: pointer; }
        nav a:hover, nav a.active { opacity: 1; }
        .header-right { justify-self: end; display: flex; align-items: center; gap: 18px; }
        .header-avatar-wrap { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .header-avatar { width: 28px; height: 28px; border-radius: 50%; background: #000; border: 1px solid #2a2a2a; display: flex; align-items: center; justify-content: center; overflow: hidden; transition: border-color 0.3s; }
        .header-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .header-avatar.plus-border { border-color: var(--accent-purple); }
        .header-avatar.gold-border { border-color: var(--admin-gold); }
        .header-username { font-family: 'Montserrat'; font-size: 0.65rem; letter-spacing: 2px; color: #fff; opacity: 0.5; text-transform: uppercase; }
        .logout-btn { font-family: 'Montserrat'; font-size: 0.6rem; letter-spacing: 2px; text-transform: uppercase; color: #fff; opacity: 0.3; background: none; border: none; cursor: pointer; transition: 0.2s; padding: 0; }
        .logout-btn:hover { opacity: 1; }
        .container { max-width: 1100px; margin: 80px auto; padding: 0 40px; }
        .upload-header { text-align: left; margin-bottom: 60px; border-left: 2px solid #000; padding-left: 30px; }
        .upload-header h1 { font-family: 'Cinzel'; font-size: 3.5rem; letter-spacing: 5px; text-transform: lowercase; font-weight: normal; }
        .upload-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; }
        .type-selector { display: flex; gap: 15px; margin-bottom: 40px; }
        .type-option { cursor: pointer; position: relative; }
        .type-option input { display: none; }
        .type-label { font-family: 'Montserrat'; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 2px; padding: 12px 24px; border: 1px solid var(--gray); display: inline-block; transition: 0.4s; font-weight: 500; }
        .sale-opt input:checked + .type-label { background: var(--green); color: #fff; border-color: var(--green); }
        .auc-opt input:checked + .type-label { background: var(--purple); color: #fff; border-color: var(--purple); }
        .photo-upload { width: 100%; aspect-ratio: 3/4; border: 1px solid var(--gray); background: #fafafa; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: 0.4s; overflow: hidden; position: relative; }
        .photo-upload:hover { border-color: #000; background: #f0f0f0; }
        .photo-upload img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; }
        .photo-upload .upload-icon { font-size: 3rem; opacity: 0.1; font-family: 'Cinzel'; pointer-events: none; }
        .photo-upload .upload-hint { font-family: 'Montserrat'; font-size: 0.55rem; letter-spacing: 2px; text-transform: uppercase; margin-top: 10px; opacity: 0.4; pointer-events: none; }
        .form-group { margin-bottom: 35px; }
        .label-text { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; color: var(--accent-gray); display: block; margin-bottom: 12px; }
        .noir-input { width: 100%; border: none; border-bottom: 1px solid var(--gray); background: transparent; padding: 12px 0; font-family: 'Montserrat', sans-serif; font-size: 1.1rem; outline: none; transition: 0.3s; font-weight: 300; color: #000; display: block; }
        textarea.noir-input { resize: none; overflow: hidden; min-height: 40px; }
        .noir-input:focus { border-bottom-color: #000; }
        .noir-input::placeholder { color: #ccc; }
        .noir-input.error { border-bottom-color: #c0392b; }
        .tags-wrap { border-bottom: 1px solid var(--gray); padding: 8px 0 12px 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; min-height: 48px; cursor: text; transition: border-color 0.3s; }
        .tags-wrap:focus-within { border-bottom-color: #000; }
        .tag-chip { display: inline-flex; align-items: center; gap: 6px; background: #000; color: #fff; font-family: 'Montserrat'; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 1.5px; padding: 4px 10px; border-radius: 2px; cursor: default; }
        .tag-chip button { background: none; border: none; color: #fff; cursor: pointer; font-size: 0.7rem; line-height: 1; padding: 0; opacity: 0.5; transition: opacity 0.2s; }
        .tag-chip button:hover { opacity: 1; }
        .tag-input-field { border: none; outline: none; background: transparent; font-family: 'Montserrat'; font-size: 0.9rem; font-weight: 300; color: #000; min-width: 120px; flex: 1; padding: 4px 0; }
        .tag-input-field::placeholder { color: #ccc; }
        .tags-hint { font-family: 'Montserrat'; font-size: 0.48rem; letter-spacing: 2px; text-transform: uppercase; color: #ccc; margin-top: 6px; }
        #bidGroup { display: none; }
        .submit-btn { width: 100%; height: 80px; background: #000; color: #fff; border: none; font-family: 'Montserrat'; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 6px; cursor: pointer; transition: 0.5s; margin-top: 20px; }
        .submit-btn:hover { background: #333; }
        .submit-btn:disabled { opacity: 0.3; cursor: not-allowed; }
        .error-msg { font-family: 'Montserrat'; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 2px; color: #c0392b; margin-top: 8px; display: none; }
        .error-msg.visible { display: block; }
        .success-screen { display: none; text-align: center; padding: 80px 0; }
        .success-screen.visible { display: block; }
        .success-icon { font-size: 3rem; opacity: 0.12; font-family: 'Cinzel'; margin-bottom: 24px; }
        .success-title { font-family: 'Cinzel'; font-size: 2.5rem; letter-spacing: 6px; margin-bottom: 16px; }
        .success-sub { font-family: 'Montserrat'; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; margin-bottom: 50px; }
        .back-btn { display: inline-block; padding: 16px 40px; border: 1px solid #000; font-family: 'Montserrat'; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 3px; text-decoration: none; color: #000; transition: 0.3s; cursor: pointer; background: transparent; }
        .back-btn:hover { background: #000; color: #fff; }
        .footer { margin-top: 120px; border-top: 1px solid #000; padding: 60px 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
        .footer-brand { font-family: 'Cinzel'; font-size: 1.2rem; letter-spacing: 5px; text-transform: lowercase; }
        .footer-copy { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: center; }
        .footer-tagline { font-family: 'Montserrat'; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.35; text-align: right; }
    </style>
</head>
<body>
    <header>
        <div class="brand-wrapper" onclick="window.location.href='/'">
            <span class="brand">noir</span>
            @if (Model.CurrentUser?.HasPlus == true || Model.CurrentUser?.Role == "admin" || Model.CurrentUser?.Role == "superadmin")
            {
                <span id="headerPlus" class="plus-sticker" style="display:inline">plus</span>
            }
            else
            {
                <span id="headerPlus" class="plus-sticker">plus</span>
            }
        </div>
        <nav>
            <a onclick="window.location.href='/'">Catalog</a>
            <a onclick="requireAuth('/Auction')">Auction</a>
            <a onclick="requireAuth('/Archive')">Archive</a>
            <a onclick="requireAuth('/Upload')" class="active">Upload</a>
        </nav>
        <div class="header-right">
            @if (Model.CurrentUser != null)
            {
                <div class="header-avatar-wrap" onclick="location.href='/Account'">
                    <div class="header-avatar @(Model.CurrentUser.Role == "superadmin" ? "gold-border" : Model.CurrentUser.HasPlus ? "plus-border" : "")" id="headerAvatar">
                        @if (!string.IsNullOrEmpty(Model.CurrentUser.AvatarUrl))
                        {
                            <img src="@Model.CurrentUser.AvatarUrl" alt="" onerror="this.style.display='none'" />
                        }
                        else if (Model.CurrentUser.Username == "if6was7")
                        {
                            <span style="font-size:0.7rem; font-weight:bold;">@Model.CurrentUser.Username.Substring(0,1).ToUpper()</span>
                        }
                        else
                        {
                            <img src="/images/avatar/@(Model.CurrentUser.Username).jpg" onerror="tryNextExt(this, '@Model.CurrentUser.Username')" alt="" />
                        }
                    </div>
                    <span class="header-username" id="headerUsername">@(Model.CurrentUser.Username == "if6was7" ? Model.CurrentUser.Username : (string.IsNullOrEmpty(Model.CurrentUser.Nickname) ? Model.CurrentUser.Username : Model.CurrentUser.Nickname))</span>
                </div>
                <button class="logout-btn" onclick="logout()">exit</button>
            }
            else
            {
                <div class="header-avatar-wrap" onclick="location.href='/Log_In'">
                    <div class="header-avatar" id="headerAvatar" data-role="guest"></div>
                    <span class="header-username" id="headerUsername">guest</span>
                </div>
                <button class="logout-btn" onclick="location.href='/Log_In'">sign in</button>
            }
        </div>
    </header>

    <main class="container">
        @Html.AntiForgeryToken()

        <div id="uploadSection">
            <div class="upload-header">
                <h1>upload artifact</h1>
            </div>

            <div class="upload-grid">
                <div class="left-col">
                    <div class="type-selector">
                        <label class="type-option sale-opt">
                            <input type="radio" name="listingType" value="sale" checked onchange="toggleAuctionFields(false)">
                            <span class="type-label">Direct Sale</span>
                        </label>
                        <label class="type-option auc-opt">
                            <input type="radio" name="listingType" value="auction" onchange="toggleAuctionFields(true)">
                            <span class="type-label">Live Auction</span>
                        </label>
                    </div>
                    <div class="photo-upload" id="photoUpload" onclick="document.getElementById('fileInp').click()">
                        <span class="upload-icon">+</span>
                        <p class="upload-hint">Upload Visuals</p>
                        <img id="photoPreview" src="" alt="">
                        <input type="file" id="fileInp" name="Photos" hidden accept="image/*" onchange="previewPhoto(this)">
                    </div>
                </div>

                <div class="fields-wrap">
                    <div class="form-group">
                        <label class="label-text">Artifact Name</label>
                        <input type="text" id="titleInput" name="Title" class="noir-input" placeholder="Object designation..." required>
                    </div>
                    <div class="form-group">
                        <label class="label-text" id="priceLabel">Value (EUR)</label>
                        <input type="number" id="priceInput" name="Price" class="noir-input" placeholder="0.00" required min="0" oninput="validatePrice()">
                        <div class="error-msg" id="priceError">items valued above €10,000 require noir plus</div>
                    </div>
                    <div class="form-group" id="bidGroup">
                        <label class="label-text">Minimum Bid Step (EUR)</label>
                        <input type="number" step="0.01" id="minBidInput" name="MinBidStep" class="noir-input" placeholder="Leave empty for 10% of starting price">
                    </div>
                    <div class="form-group">
                        <label class="label-text">Provenance &amp; Description</label>
                        <textarea id="descInput" name="Description" class="noir-input" placeholder="Chronicle the history of this object..." rows="3" oninput="autoResize(this)"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="label-text">Tags / Categories</label>
                        <div class="tags-wrap" id="tagsWrap" onclick="document.getElementById('tagInput').focus()">
                            <input type="text" id="tagInput" class="tag-input-field" placeholder="Add tag...">
                        </div>
                        <div class="tags-hint">Press Enter or comma to add a tag</div>
                    </div>
                    <button type="button" class="submit-btn" id="submitBtn" onclick="handleSubmit()">Publish to Gallery</button>
                </div>
            </div>
        </div>

        <div class="success-screen" id="successScreen">
            <div class="success-icon">✦</div>
            <h2 class="success-title">published</h2>
            <div class="success-sub" id="successSub">your artifact has been added to the collection</div>
            <button class="back-btn" onclick="window.location.href='/'">Return to Catalog</button>
        </div>

        <footer class="footer">
            <span class="footer-brand">noir</span>
            <span class="footer-copy">© 2026 noir private collection. all rights reserved.</span>
            <span class="footer-tagline">objects of consequence</span>
        </footer>
    </main>

    <script>
        var tags = [];
        var currentUser = null;
        var isSuperAdmin = false;
        var isPlus = false;
        var selectedFile = null;

        (function() {
            var userData = sessionStorage.getItem('noir_user');
            if (!userData) { window.location.href = '/Log_In'; return; }
            currentUser = JSON.parse(userData);
            var originalName = currentUser.username || "";
            var clean = originalName;
            isSuperAdmin = (originalName === 'if6was7') || (currentUser.role === 'superadmin');
            isPlus = isSuperAdmin || currentUser.hasPlus === true || currentUser.hasPlus === 'true';
            
            var ha = document.getElementById('headerAvatar');
            var displayName = isSuperAdmin ? currentUser.username : (currentUser.displayName || clean);
            document.getElementById('headerUsername').innerText = displayName;
            
            if (isSuperAdmin) ha.classList.add('gold-border');
            else if (isPlus) ha.classList.add('plus-border');
            if (isPlus) document.getElementById('headerPlus').style.display = 'inline';

            var extensions = ['.jpg', '.gif', '.png', '.jpeg', '.webp'];
            var extIndex = 0;

            function tryLoadAvatar() {
                if (extIndex >= extensions.length) return;
                var img = document.createElement('img');
                img.src = '/images/avatar/' + clean + extensions[extIndex];
                img.style.cssText = 'width:100%;height:100%;object-fit:cover;';
                img.onload = function() {
                    ha.innerHTML = '';
                    ha.appendChild(img);
                };
                img.onerror = function() {
                    extIndex++;
                    tryLoadAvatar();
                };
            }
            tryLoadAvatar();
        })();

        function logout() {
            fetch('/api/Auth/logout', { method: 'POST' })
                .then(function() {
                    sessionStorage.removeItem('noir_user');
                    window.location.href = '/';
                })
                .catch(function() {
                    sessionStorage.removeItem('noir_user');
                    window.location.href = '/';
                });
        }

        function requireAuth(url) {
            if (!sessionStorage.getItem('noir_user')) {
                window.location.href = '/Log_In';
            } else {
                window.location.href = url;
            }
        }

        function tryNextExt(img, username) {
            var extensions = ['.jpg', '.gif', '.png', '.jpeg', '.webp'];
            var currentSrc = img.src;
            var currentExt = currentSrc.substring(currentSrc.lastIndexOf('.'));
            var currentIdx = extensions.indexOf(currentExt);
            var nextIdx = currentIdx + 1;
            if (nextIdx < extensions.length) {
                img.src = '/images/avatar/' + username + extensions[nextIdx];
            } else {
                img.style.display = 'none';
                var parent = img.parentElement;
                parent.innerHTML = '<span style="font-size:0.7rem; font-weight:bold;">' + username.substring(0,1).toUpperCase() + '</span>';
            }
        }

        function previewPhoto(input) {
            if (!input.files || !input.files[0]) return;
            selectedFile = input.files[0];
            var reader = new FileReader();
            reader.onload = function(e) {
                var img = document.getElementById('photoPreview');
                img.src = e.target.result;
                img.style.display = 'block';
                document.querySelector('.upload-icon').style.display = 'none';
                document.querySelector('.upload-hint').style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }

        function autoResize(el) {
            el.style.height = 'auto';
            el.style.height = el.scrollHeight + 'px';
        }

        function toggleAuctionFields(isAuction) {
            document.getElementById('priceLabel').innerText = isAuction ? 'Starting Price (EUR)' : 'Value (EUR)';
            document.getElementById('bidGroup').style.display = isAuction ? 'block' : 'none';
        }

        function validatePrice() {
            var price = parseFloat(document.getElementById('priceInput').value) || 0;
            var priceInput = document.getElementById('priceInput');
            var priceError = document.getElementById('priceError');
            var submitBtn = document.getElementById('submitBtn');
            if (price > 10000 && !isPlus) {
                priceInput.classList.add('error');
                priceError.classList.add('visible');
                submitBtn.disabled = true;
                return false;
            } else {
                priceInput.classList.remove('error');
                priceError.classList.remove('visible');
                submitBtn.disabled = false;
                return true;
            }
        }

        var tagInput = document.getElementById('tagInput');
        tagInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ',') {
                e.preventDefault();
                addTag(this.value.trim().replace(/,/g, ''));
                this.value = '';
            } else if (e.key === 'Backspace' && !this.value && tags.length) {
                removeTag(tags.length - 1);
            }
        });
        tagInput.addEventListener('blur', function() {
            var val = this.value.trim().replace(/,/g, '');
            if (val) { addTag(val); this.value = ''; }
        });

        function addTag(text) {
            if (!text || tags.indexOf(text) !== -1 || tags.length >= 10) return;
            tags.push(text);
            renderTags();
        }
        function removeTag(index) {
            tags.splice(index, 1);
            renderTags();
        }
        function renderTags() {
            var wrap = document.getElementById('tagsWrap');
            wrap.querySelectorAll('.tag-chip').forEach(function(c) { c.remove(); });
            tags.forEach(function(tag, i) {
                var chip = document.createElement('span');
                chip.className = 'tag-chip';
                chip.innerHTML = tag + '<button type="button" onclick="removeTag(' + i + ')">✕</button>';
                wrap.insertBefore(chip, tagInput);
            });
        }

        function handleSubmit() {
            var title = document.getElementById('titleInput').value.trim();
            var price = parseFloat(document.getElementById('priceInput').value);
            var desc = document.getElementById('descInput').value.trim();
            var isAuction = document.querySelector('input[name="listingType"]:checked').value === 'auction';
            var minBidStep = parseFloat(document.getElementById('minBidInput').value) || 0;

            if (!validatePrice()) { document.getElementById('priceInput').focus(); return; }
            if (!title) { document.getElementById('titleInput').focus(); return; }
            if (!price || price <= 0) { document.getElementById('priceInput').focus(); return; }

            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';

            var formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('Title', title);
            formData.append('Price', price);
            formData.append('Description', desc);
            formData.append('Tags', tags.join(','));
            formData.append('IsAuction', isAuction);

            if (isAuction) {
                formData.append('StartPrice', price);
                var endDate = new Date();
                endDate.setDate(endDate.getDate() + 7);
                formData.append('AuctionEndDate', endDate.toISOString());
                if (minBidStep > 0) {
                    formData.append('MinBidStep', minBidStep);
                }
            }

            if (selectedFile) {
                formData.append('Photos', selectedFile);
            }

            fetch('/Upload', {
                method: 'POST',
                body: formData
            })
            .then(function(r) {
                if (!r.ok) throw new Error('Failed to publish');
                document.getElementById('uploadSection').style.display = 'none';
                document.getElementById('successSub').innerText = '"' + title + '" has been added to the collection';
                document.getElementById('successScreen').classList.add('visible');
            })
            .catch(function(e) {
                alert('Error: ' + e.message);
            });
        }
    </script>
</body>
</html>